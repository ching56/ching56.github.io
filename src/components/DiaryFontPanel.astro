---
// Dev-only comparison panel for the diary date face. Pure CSS: each radio
// sets --diary-date-font through :has(). Web candidates load from Google Fonts
// as a digits-and-slash subset, in dev only; the production build never sees
// this component or that stylesheet.
const SAMPLE = "2026/11/12";

const groups = [
  {
    label: "系統",
    options: [
      { name: "系統預設（訪客實際看到）", value: "" },
      { name: "Bradley Hand（Apple）", value: '"Bradley Hand"' },
      { name: "Noteworthy（Apple）", value: '"Noteworthy"' },
      { name: "Chalkboard SE（Apple）", value: '"Chalkboard SE"' },
      { name: "Marker Felt（Apple）", value: '"Marker Felt"' },
      { name: "Snell Roundhand（Apple）", value: '"Snell Roundhand"' },
      { name: "casual / Coming Soon（Android）", value: "casual" },
      { name: "cursive / Dancing Script（Android）", value: "cursive" },
      { name: "Segoe Print（Windows）", value: '"Segoe Print"' },
      { name: "Ink Free（Windows）", value: '"Ink Free"' },
    ],
  },
  {
    label: "網路字型",
    options: [
      "Caveat",
      "Patrick Hand",
      "Gochi Hand",
      "Kalam",
      "Shadows Into Light",
      "Indie Flower",
      "Reenie Beanie",
      "Homemade Apple",
      "Nanum Pen Script",
      "Covered By Your Grace",
    ].map((family) => ({ name: family, value: `"${family}"` })),
  },
];

const webFamilies = groups[1].options.map(({ name }) => name);
const fontsHref =
  "https://fonts.googleapis.com/css2?" +
  webFamilies.map((family) => `family=${family.replaceAll(" ", "+")}`).join("&") +
  `&text=${encodeURIComponent("0123456789/")}&display=swap`;

const options = groups.flatMap(({ options }) => options);
const rules = options
  .map(
    ({ value }, index) =>
      value &&
      `html:has(#diary-font-${index}:checked){--diary-date-font:${value},cursive}`,
  )
  .filter(Boolean)
  .join("\n");
---

<link rel="stylesheet" href={fontsHref} />
<style set:html={rules}></style>
<details class="font-panel">
  <summary>日期字型</summary>
  {groups.map(({ label, options: groupOptions }) => (
    <fieldset>
      <legend>{label}</legend>
      {groupOptions.map((option) => {
        const index = options.indexOf(option);
        return (
          <label>
            <input
              type="radio"
              name="diary-font"
              id={`diary-font-${index}`}
              checked={index === 0}
            />
            <span
              class="font-panel-sample"
              style={option.value ? `font-family:${option.value},cursive` : "font-family:var(--diary-date-system-font)"}
            >
              {SAMPLE}
            </span>
            <span class="font-panel-name">{option.name}</span>
          </label>
        );
      })}
    </fieldset>
  ))}
</details>

<style>
  .font-panel {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 20;
    max-height: min(80dvh, 40rem);
    overflow: auto;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: rgb(252 253 251 / 96%);
    box-shadow: 0 6px 24px rgb(0 0 0 / 14%);
    font-size: 0.8125rem;
  }

  .font-panel summary {
    cursor: pointer;
    color: var(--ink-muted);
  }

  .font-panel fieldset {
    margin: 0.5rem 0 0;
    padding: 0;
    border: 0;
  }

  .font-panel legend {
    padding: 0;
    color: var(--ink-muted);
  }

  .font-panel label {
    display: grid;
    grid-template-columns: auto 7rem 1fr;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    cursor: pointer;
  }

  /* Same size as the diary date, so each sample previews the real thing. */
  .font-panel-sample {
    font-size: 1.5rem;
    white-space: nowrap;
  }

  .font-panel-name {
    color: var(--ink-muted);
  }
</style>
