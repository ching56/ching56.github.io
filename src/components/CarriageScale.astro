---
// A typewriter's paper scale: one tick per character cell, a number every ten.
// It sits above typed text at the same size, so the page shows its own grid.
const CELLS = 120;
let numbers = "";
let ticks = "";

for (let cell = 0; cell < CELLS; cell += 1) {
  ticks += cell % 10 === 0 ? "|" : cell % 5 === 0 ? ":" : ".";
  if (cell % 10 === 0) numbers = numbers.padEnd(cell, " ") + String(cell);
}
---

<pre class="carriage-scale" aria-hidden="true">{`${numbers.padEnd(CELLS, " ")}\n${ticks}`}</pre>
