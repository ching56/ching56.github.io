---
// The bottle from its 21-frame turntable cutout (assets rebuilt by
// scripts/build-bottle-assets.mjs). "turntable" is the homepage hero: the real
// photo, set larger than the screen, which turns on scroll and darkens into a
// solid silhouette (the photo's own outline, filled with ink) as it docks as
// the home logo. At rest it shows a full-resolution still of the first frame.
// "logo" is that docked state on every other page: the last frame's outline.
import { Image } from "astro:assets";

import mark from "../assets/home/bottle-mark.webp";
import spin from "../assets/home/bottle-spin.webp";
import spinSmall from "../assets/home/bottle-spin-small.webp";
import still from "../assets/home/bottle-still.webp";

interface Props {
  variant: "turntable" | "logo";
  href?: string;
  label?: string;
}

const FRAMES = 21;
const { variant, href, label } = Astro.props;
---

{
  variant === "turntable" ? (
    <a class="home-bottle" href={href} aria-label={label} style={`--frames:${FRAMES};--sprite-large:url(${spin.src});--sprite-small:url(${spinSmall.src})`}>
      <span class="bottle-photo" aria-hidden="true"></span>
      <Image
        class="bottle-still"
        src={still}
        alt=""
        widths={[160, 264, 400]}
        sizes="(max-width: 48rem) 6.5vh, 14.6vh"
        loading="eager"
        fetchpriority="high"
      />
      <span class="bottle-silhouette" aria-hidden="true"></span>
    </a>
  ) : (
    <span class="bottle-logo" style={`--mark:url(${mark.src})`} aria-hidden="true"></span>
  )
}
