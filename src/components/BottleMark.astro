---
// The bottle from its 21-frame turntable cutout (assets rebuilt by
// scripts/build-bottle-assets.mjs). "turntable" is the homepage hero: the real
// photo, which, once the page scrolls past a threshold, turns once on its
// turntable and darkens into a solid silhouette (the photo's own outline,
// filled with ink) as it docks, lying on its side, as the home logo. At rest
// it shows a full-resolution still of the first frame. "logo" is that docked
// state on every other page: the last frame's outline.
import { Image } from "astro:assets";

import mark from "../assets/home/bottle-mark.webp";
import spin from "../assets/home/bottle-spin.webp";
import spinSmall from "../assets/home/bottle-spin-small.webp";
import still from "../assets/home/bottle-still.webp";

interface Props {
  variant: "turntable" | "logo";
  href?: string;
  label?: string;
}

const FRAMES = 21;
const { variant, href, label } = Astro.props;
---

{
  variant === "turntable" ? (
    <a class="home-bottle" href={href} aria-label={label} data-sprite-large={spin.src}
      data-sprite-small={spinSmall.src}
      style={`--frames:${FRAMES};--sprite-large:url(${spin.src});--sprite-small:url(${spinSmall.src})`}>
      <span class="bottle-photo" aria-hidden="true"></span>
      <Image
        class="bottle-still"
        src={still}
        alt=""
        widths={[160, 264, 400]}
        sizes="(max-width: 48rem) 6.5vh, 14.6vh"
        loading="eager"
        fetchpriority="high"
      />
      <span class="bottle-silhouette" aria-hidden="true"></span>
    </a>
    <script is:inline>
      // The turntable turns only once its sprite is in hand: per sprite
      // size, idle -> loading -> ready | failed (no retry). data-spin
      // follows the current size. Data saver, 2G, an error or 8s: no turn.
      (() => {
        const root = document.documentElement;
        const bottle = document.querySelector(".home-bottle");
        const still = bottle && bottle.querySelector(".bottle-still");
        const connection = navigator.connection;
        if (!still || (connection && (connection.saveData || /2g$/.test(connection.effectiveType)))) return;
        const narrow = matchMedia("(max-width: 48rem)");
        const transitions = {
          idle: { request: "loading" },
          loading: { loaded: "ready", failed: "failed" },
          ready: {},
          failed: {},
        };
        const sizes = { small: "idle", large: "idle" };
        const current = () => (narrow.matches ? "small" : "large");
        const sync = () => {
          if (sizes[current()] === "ready") root.dataset.spin = "ready";
          else delete root.dataset.spin;
        };
        const send = (size, event) => {
          const next = transitions[sizes[size]][event];
          if (!next) return false;
          sizes[size] = next;
          sync();
          return true;
        };
        const show = () => {
          const size = current();
          sync();
          if (!send(size, "request")) return;
          const sprite = new Image();
          const timeout = setTimeout(() => {
            sprite.removeAttribute("src");
            send(size, "failed");
          }, 8000);
          sprite.onload = () => {
            clearTimeout(timeout);
            send(size, "loaded");
          };
          sprite.onerror = () => {
            clearTimeout(timeout);
            send(size, "failed");
          };
          sprite.src = size === "small" ? bottle.dataset.spriteSmall : bottle.dataset.spriteLarge;
        };
        if (still.complete && still.naturalWidth) show();
        else still.addEventListener("load", show, { once: true });
        narrow.addEventListener("change", show);
      })();

      // The bottle morphs across pages only from the hero. Docked, it is
      // already where every header's mark sits, so the page just changes.
      (() => {
        const bottle = document.querySelector(".home-bottle");
        if (!bottle) return;
        const root = document.documentElement;
        const guard = (event) => {
          if (!event.viewTransition) return;
          const docked = scrollY >= parseFloat(getComputedStyle(root).getPropertyValue("--dock-threshold"));
          const box = bottle.getBoundingClientRect();
          if (!docked && box.bottom > 0 && box.top < innerHeight) return;
          event.viewTransition.skipTransition();
        };
        addEventListener("pageswap", guard);
        addEventListener("pagereveal", guard);
      })();
    </script>
  ) : (
    <span class="bottle-logo" style={`--mark:url(${mark.src})`} aria-hidden="true"></span>
  )
}
