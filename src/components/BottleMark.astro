---
// The bottle from its 21-frame turntable cutout (assets rebuilt by
// scripts/build-bottle-assets.mjs). "turntable" is the homepage hero: the real
// photo, which, once the page scrolls past a threshold, turns once on its
// turntable and darkens into a solid silhouette (the photo's own outline,
// filled with ink) as it docks, lying on its side, as the home logo. At rest
// it shows a full-resolution still of the first frame. "logo" is that docked
// state on every other page: the last frame's outline.
import { Image } from "astro:assets";
import { transformSync } from "esbuild";

import mark from "../assets/home/bottle-mark.webp";
import spin from "../assets/home/bottle-spin.webp";
import spinSmall from "../assets/home/bottle-spin-small.webp";
import still from "../assets/home/bottle-still.webp";
import bottleSource from "../scripts/bottle-home.js?raw";

interface Props {
  variant: "turntable" | "logo";
  href?: string;
  label?: string;
}

// The turntable's inline script (src/scripts/bottle-home.js, inlined
// minified; the home page's inline budget is 3 KB) runs the bottle as explicit state
// machines, built by one tiny machine(table, state, changed) helper; render()
// derives every root attribute from their states and nothing else writes
// them:
//   place   hero --past--> docked --back--> hero   (scrollY vs --dock-threshold)
//           returning --past|hand--> docked: a return (history or reload) to a
//           home left docked; shown docked, deaf to "back" while the browser
//           restores the scroll (which passes through small values)
//           -> html[data-bottle]; CSS docks the bottle from it. The head
//           script (BottleHead.astro, bottle-head.js) seeds it before the
//           first frame: coming back to home (history or reload) starts in
//           the place it was left in (saved on pagehide), so it is docked
//           before the browser restores scroll or a transition captures it.
//   motion  still --hand--> live   (first wheel, touch, key or pointer)
//           -> html[data-bottle-motion]; while still, docking is instant, so
//           a page reopened scrolled down never plays the move. Seeded
//           still only with a docked seed; every other arrival starts live,
//           so the first scroll from the top plays the move however it
//           scrolls (a still->live flip in the same style change as the dock
//           would not transition).
//   sprite  per size, idle --request--> loading --loaded--> ready
//                                               --failed--> failed (no retry)
//           -> html[data-spin="ready"] for the current size. Started after
//           the still has loaded; skipped on data saver or 2G; 8s timeout.
// Across pages the bottle moves only when its two ends look different: in
// the hero (a photo) it morphs into or out of the header mark, both ways.
// Docked, it already is the mark, exactly where every header's mark sits;
// CSS then gives it no transition name (navigation.css), so the mark stays
// still. No script decides this, so it works without pageswap/pagereveal.
const FRAMES = 21;
// Shipped minified: readable source, small page.
const bottleScript = transformSync(bottleSource, { minify: true, target: "es2020" }).code.trim();
const { variant, href, label } = Astro.props;
---

{
  variant === "turntable" ? (
    <a class="home-bottle" href={href} aria-label={label} data-sprite-large={spin.src}
      data-sprite-small={spinSmall.src}
      style={`--frames:${FRAMES};--sprite-large:url(${spin.src});--sprite-small:url(${spinSmall.src})`}>
      <span class="bottle-photo" aria-hidden="true"></span>
      <Image
        class="bottle-still"
        src={still}
        alt=""
        widths={[160, 264, 400]}
        sizes="(max-width: 48rem) 6.5vh, 14.6vh"
        loading="eager"
        fetchpriority="high"
      />
      <span class="bottle-silhouette" aria-hidden="true"></span>
    </a>
    <script is:inline set:html={bottleScript}></script>
  ) : (
    <span class="bottle-logo" style={`--mark:url(${mark.src})`} aria-hidden="true"></span>
  )
}
