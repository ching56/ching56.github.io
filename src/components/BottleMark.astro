---
// The bottle from its 21-frame turntable cutout (assets rebuilt by
// scripts/build-bottle-assets.mjs). "turntable" is the homepage hero: the real
// photo, which turns once on its turntable as the reader scrolls it away. At
// rest it shows a full-resolution still of the first frame. "logo" is the
// small silhouette (the last frame's outline) in the article header.
import { Image } from "astro:assets";

import mark from "../assets/home/bottle-mark.webp";
import spin from "../assets/home/bottle-spin.webp";
import spinSmall from "../assets/home/bottle-spin-small.webp";
import still from "../assets/home/bottle-still.webp";

interface Props {
  variant: "turntable" | "logo";
  href?: string;
  label?: string;
}

const FRAMES = 21;
const { variant, href, label } = Astro.props;
---

{
  variant === "turntable" ? (
    <a class="home-bottle" href={href} aria-label={label} data-sprite-large={spin.src}
      data-sprite-small={spinSmall.src}
      style={`--frames:${FRAMES};--sprite-large:url(${spin.src});--sprite-small:url(${spinSmall.src})`}>
      <span class="bottle-photo" aria-hidden="true"></span>
      <Image
        class="bottle-still"
        src={still}
        alt=""
        widths={[160, 264, 400]}
        sizes="(max-width: 48rem) 6.5vh, 14.6vh"
        loading="eager"
        fetchpriority="high"
      />
    </a>
    <script is:inline>
      // The turntable only turns once its sprite is in hand. The still loads
      // first; the sprite for this screen follows, and only once it has
      // loaded does data-spin="ready" let CSS use it. Data saver, 2G, or no
      // sprite within 8s: the bottle stays still.
      (() => {
        const root = document.documentElement;
        const bottle = document.querySelector(".home-bottle");
        const still = bottle && bottle.querySelector(".bottle-still");
        const connection = navigator.connection;
        if (!still || (connection && (connection.saveData || /2g$/.test(connection.effectiveType)))) return;
        const narrow = matchMedia("(max-width: 48rem)");
        const loaded = new Set();
        const sync = () => {
          if (loaded.has(narrow.matches)) root.dataset.spin = "ready";
          else delete root.dataset.spin;
        };
        const load = () => {
          sync();
          if (loaded.has(narrow.matches)) return;
          const small = narrow.matches;
          const sprite = new Image();
          const timeout = setTimeout(() => sprite.removeAttribute("src"), 8000);
          sprite.onload = () => {
            clearTimeout(timeout);
            loaded.add(small);
            sync();
          };
          sprite.onerror = () => clearTimeout(timeout);
          sprite.src = small ? bottle.dataset.spriteSmall : bottle.dataset.spriteLarge;
        };
        if (still.complete && still.naturalWidth) load();
        else still.addEventListener("load", load, { once: true });
        narrow.addEventListener("change", load);
      })();

      // The bottle morphs across pages only while it is on screen. Leaving
      // or landing on home scrolled past it, the page simply changes, with
      // no transition at all.
      (() => {
        const bottle = document.querySelector(".home-bottle");
        if (!bottle) return;
        const guard = (event) => {
          if (!event.viewTransition) return;
          const box = bottle.getBoundingClientRect();
          if (box.bottom > 0 && box.top < innerHeight) return;
          event.viewTransition.skipTransition();
        };
        addEventListener("pageswap", guard);
        addEventListener("pagereveal", guard);
      })();
    </script>
  ) : (
    <span class="bottle-logo" style={`--mark:url(${mark.src})`} aria-hidden="true"></span>
  )
}
