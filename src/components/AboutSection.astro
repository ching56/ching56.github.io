---
import { render, type CollectionEntry } from "astro:content";

import { UI } from "../config/i18n";
import { SITE } from "../config/site.js";

interface Props {
  page: CollectionEntry<"posts">;
}

const { page } = Astro.props;
const { Content } = await render(page);
const ui = UI[page.data.language];
---

<section id="about" class="about-intro" aria-label={ui.aboutLabel}>
  <div class="about-intro-main">
    <div class="about-copy">
      <Content />
    </div>
    <footer class="about-cta">
      <a href={`mailto:${SITE.author.email}`}>
        <svg class="mail-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M2.5 4h11v8h-11zM2.5 4 8 8.5 13.5 4" />
        </svg>
        {SITE.author.email}
      </a>
    </footer>
  </div>
</section>
