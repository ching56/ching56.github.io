---
import { render, type CollectionEntry } from "astro:content";

import { UI } from "../config/i18n";
import ResponseEnding from "./ResponseEnding.astro";
import { SITE } from "../config/site.js";

interface Props {
  page: CollectionEntry<"posts">;
}

const { page } = Astro.props;
const { Content } = await render(page);
const ui = UI[page.data.language];
---

<section id="about" class="about-intro" aria-label={ui.aboutLabel}>
  <div class="about-intro-main">
    <div class="about-copy">
      <Content />
    </div>
    <ResponseEnding
      language={page.data.language}
      kind="mail"
      href={`mailto:${SITE.author.email}`}
      label={SITE.author.email}
    />
  </div>
</section>
