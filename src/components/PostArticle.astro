---
import { getCollection, render, type CollectionEntry } from "astro:content";

import { UI } from "../config/i18n";
import { SITE } from "../config/site.js";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostDate, getPostLabel, getPostSlug, getPostStep } from "../lib/posts";
import MusicLinkCard from "./MusicLinkCard.astro";
import PostLikes from "./PostLikes.astro";
import ResponseEnding from "./ResponseEnding.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = getPostDate(post.data.date, post.data.language);
const slug = getPostSlug(post);
const matchingPosts = (await getCollection("posts")).filter(
  (candidate) =>
    getPostSlug(candidate) === slug &&
    candidate.data.contentType === post.data.contentType &&
    candidate.data.published,
);
const translatedPost = matchingPosts.find(
  (candidate) => candidate.data.language !== post.data.language,
);
const alternates = translatedPost
  ? matchingPosts.map((candidate) => ({
      language: candidate.data.language,
      path: `/${candidate.data.language}/blog/${slug}/`,
    }))
  : [];
const translatedPostPath = translatedPost
  ? `/${translatedPost.data.language}/blog/${slug}/`
  : undefined;
const ui = UI[post.data.language];
const label = getPostLabel(post);
const step = await getPostStep(post);
---

<BaseLayout
  title={label}
  language={post.data.language}
  alternates={alternates}
  languageSwitchPath={translatedPostPath}
>
  <article class="reading-article">
    <header class:list={["post-header", { "post-header--untitled": !post.data.title }]}>
      <p class="diary-step"><span class="visually-hidden">{post.data.language === "zh-TW" ? "步驟 " : "Step "}</span>{step}</p>
      {
        post.data.title ? (
          <h1>{post.data.title}</h1>
        ) : (
          <h1 class="visually-hidden">{label}</h1>
        )
      }
      <p class="diary-date">
        <time datetime={date.dateTime}>{date.dateTime.replaceAll("-", "/")}</time>
      </p>
    </header>
    {post.data.musicLinkCard && <MusicLinkCard card={post.data.musicLinkCard} />}
    <div class="post-body">
      <Content />
    </div>
    <PostLikes language={post.data.language} />
    {
      post.data.threadsUrl ? (
        <ResponseEnding
          language={post.data.language}
          kind="external"
          prompt={ui.threadsPrompt}
          href={post.data.threadsUrl}
          label={ui.threadsLinkLabel}
        />
      ) : (
        <ResponseEnding
          language={post.data.language}
          kind="mail"
          prompt={ui.responsePrompt}
          href={`mailto:${SITE.author.email}`}
          label={ui.responseLinkLabel}
        />
      )
    }
  </article>
</BaseLayout>
