---
import { UI, type SiteLanguage } from "../config/i18n";
import {
  byLastUpdated,
  getLastUpdated,
  getPostDate,
  getPostSlug,
  getPostsByLanguage,
} from "../lib/posts";

interface Props {
  language: SiteLanguage;
}

const { language } = Astro.props;
const ui = UI[language];
const posts = (await getPostsByLanguage(language)).sort(byLastUpdated);
---

<section class="register-panel" aria-labelledby="register-heading">
  <h1 id="register-heading" class="visually-hidden">{ui.postsLabel}</h1>
  {posts.length === 0 ? (
    <p class="empty-register">{ui.emptyPostsMessage}</p>
  ) : (
    <ol class="post-list" data-register="last-updated">
      {posts.map((post) => {
        const date = getPostDate(getLastUpdated(post), language);

        return (
          <li class="post-list-item">
            <a href={`${ui.homePath}blog/${getPostSlug(post)}/`}>
              {post.data.title}
            </a>
            <time datetime={date.dateTime}>{date.label}</time>
          </li>
        );
      })}
    </ol>
  )}
</section>
