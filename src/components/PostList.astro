---
import { UI, type SiteLanguage } from "../config/i18n";
import {
  getPostDate,
  getPostSlug,
  getPostsByLanguage,
} from "../lib/posts";

interface Props {
  language: SiteLanguage;
}

const { language } = Astro.props;
const ui = UI[language];
const posts = (await getPostsByLanguage(language)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<section class="register-panel" aria-labelledby="register-heading">
  <header class="register-header">
    <h1 id="register-heading" class="register-title">{ui.postsLabel}</h1>
  </header>
  {posts.length === 0 ? (
    <p class="empty-register">{ui.emptyPostsMessage}</p>
  ) : (
    <ol class="post-list" data-register="chronological">
      {posts.map((post) => {
        const date = getPostDate(post.data.date, language);

        return (
          <li class="post-list-item">
            <span class="accession-number" aria-hidden="true"></span>
            <a href={`${ui.homePath}blog/${getPostSlug(post)}/`}>
              {post.data.title}
            </a>
            <time datetime={date.dateTime}>{date.label}</time>
          </li>
        );
      })}
    </ol>
  )}
</section>
