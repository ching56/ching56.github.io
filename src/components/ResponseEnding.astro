---
import { UI, type SiteLanguage } from "../config/i18n";

interface Props {
  language: SiteLanguage;
  href: string;
  label: string;
  kind: "mail" | "external";
  prompt?: string;
}

const { language, href, label, kind, prompt } = Astro.props;
const external = kind === "external";
// Cloudflare's Email Address Obfuscation would swap the address for
// "[email protected]" and decode it with its own script, so the page would
// flash that text and ship runtime JS. These markers make it skip the link.
const mail = kind === "mail";
---

{mail && <Fragment set:html="<!--email_off-->" />}

<footer class="response-ending">
  {prompt && <p>{prompt}</p>}
  <a
    class="response-cta"
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
  >
    {kind === "mail" && (
      <svg class="mail-icon" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M2.5 4h11v8h-11zM2.5 4 8 8.5 13.5 4" />
      </svg>
    )}
    <span>{label}</span>
    {external && (
      <>
        <svg class="external-link-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" />
        </svg>
        <span class="visually-hidden">{UI[language].newTabLabel}</span>
      </>
    )}
  </a>
</footer>
{mail && <Fragment set:html="<!--/email_off-->" />}
