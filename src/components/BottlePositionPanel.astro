---
// Dev-only tool for placing the homepage bottle at rest and the logo it docks
// into. Drag the bottle at the top of the page, or use the sliders. Bottle
// values are kept per breakpoint, logo values once, in localStorage
// ("bottle-position") so they survive reloads and can be read back and
// written into global.css. Never rendered in production.
---

<details class="bottle-panel" open>
  <summary>調整面板　<span data-mode></span></summary>
  <div class="bottle-panel-tabs" role="tablist">
    <button type="button" role="tab" data-tab="bottle">瓶子</button>
    <button type="button" role="tab" data-tab="logo">Logo</button>
    <button type="button" role="tab" data-tab="motion">動畫</button>
    <button type="button" role="tab" data-tab="header">頁首</button>
    <button type="button" role="tab" data-tab="arrows">照片</button>
    <button type="button" role="tab" data-tab="layout">版面</button>
    <button type="button" role="tab" data-tab="paper">紙張</button>
    <button type="button" role="tab" data-tab="grid">格線</button>
    <button type="button" role="tab" data-tab="date">日期</button>
  </div>
  <section class="bottle-panel-section" role="tabpanel" data-panel="bottle">
    <label>
      <span>上</span>
      <input type="range" data-key="top" min="-20" max="80" step="1" />
      <output data-out="top"></output>
    </label>
    <label>
      <span>左</span>
      <input type="range" data-key="x" min="-20" max="90" step="1" />
      <output data-out="x"></output>
    </label>
    <label>
      <span>高</span>
      <input type="range" data-key="height" min="10" max="240" step="1" />
      <output data-out="height"></output>
    </label>
    <label>
      <span>角度</span>
      <input type="range" data-key="rotate" min="-90" max="90" step="1" />
      <output data-out="rotate"></output>
    </label>
    <label>
      <span>右距</span>
      <input type="range" data-key="gap" min="0" max="160" step="1" />
      <output data-out="gap"></output>
    </label>
    <label class="bottle-panel-wide">
      <span>文字</span>
      <select data-align>
        <option value="start">對齊瓶子上緣</option>
        <option value="center">對齊瓶子中間</option>
        <option value="end">對齊瓶子下緣</option>
      </select>
    </label>
    <p class="bottle-panel-hint">在頁面最上方直接拖曳瓶子</p>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="logo">
    <p class="bottle-panel-hint">捲到 logo 停靠後再調</p>
    <label>
      <span>上</span>
      <input type="range" data-logo="top" min="0" max="80" step="1" />
      <output data-logo-out="top"></output>
    </label>
    <label>
      <span>左</span>
      <input type="range" data-logo="left" min="-20" max="120" step="1" />
      <output data-logo-out="left"></output>
    </label>
    <label>
      <span>角度</span>
      <input type="range" data-logo="rotate" min="-180" max="180" step="1" />
      <output data-logo-out="rotate"></output>
    </label>
    <label>
      <span>寬</span>
      <input type="range" data-logo="width" min="12" max="80" step="1" />
      <output data-logo-out="width"></output>
    </label>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="motion">
    <p class="bottle-panel-hint">捲過門檻看效果</p>
    <label>
      <span>停靠</span>
      <input type="range" data-motion="out" min="100" max="1500" step="10" />
      <output data-motion-out="out"></output>
    </label>
    <label>
      <span>返回</span>
      <input type="range" data-motion="in" min="100" max="1500" step="10" />
      <output data-motion-out="in"></output>
    </label>
    <label>
      <span>門檻</span>
      <input type="range" data-motion="threshold" min="0" max="300" step="2" />
      <output data-motion-out="threshold"></output>
    </label>
    <label>
      <span>變暗</span>
      <input type="range" data-motion="darken" min="0" max="90" step="5" />
      <output data-motion-out="darken"></output>
    </label>
    <label class="bottle-panel-wide">
      <span>曲線</span>
      <select data-motion="ease">
        <option value="cubic-bezier(0.77, 0, 0.175, 1)">Emil ease-in-out</option>
        <option value="cubic-bezier(0.32, 0.72, 0, 1)">iOS drawer</option>
        <option value="cubic-bezier(0.23, 1, 0.32, 1)">Emil ease-out</option>
        <option value="cubic-bezier(0.65, 0, 0.35, 1)">柔和 in-out</option>
        <option value="linear">linear（對照）</option>
      </select>
    </label>
    <label class="bottle-panel-check">
      <input type="checkbox" data-motion="spin" />
      <span>停靠時轉台轉一圈</span>
    </label>
    <div class="bottle-panel-actions">
      <button type="button" data-emil>套用 Emil 建議</button>
    </div>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="layout">
    <p class="bottle-panel-hint">格線替排版服務：群組、對齊、節奏</p>
    <div class="bottle-panel-choices">
      <label><input type="radio" name="layout-variant" value="" />原本</label>
      <label><input type="radio" name="layout-variant" value="broken" />1 斷格</label>
      <label><input type="radio" name="layout-variant" value="manuscript" />2 稿紙</label>
      <label><input type="radio" name="layout-variant" value="baseline" />3 基線格</label>
      <label><input type="radio" name="layout-variant" value="columns" />4 欄格</label>
      <label><input type="radio" name="layout-variant" value="cutout" />5 挖空</label>
    </div>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="date">
    <p class="bottle-panel-hint">文章日期的樣式</p>
    <div class="bottle-panel-choices">
      <label><input type="radio" name="date-variant" value="" />手寫（目前）</label>
      <label><input type="radio" name="date-variant" value="bracket" />[ 方括號 ]</label>
    </div>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="grid">
    <label>
      <span>疏密</span>
      <input type="range" data-grid="cell" min="10" max="40" step="1" />
      <output data-grid-out="cell"></output>
    </label>
    <label>
      <span>濃度</span>
      <input type="range" data-grid="opacity" min="0" max="40" step="1" />
      <output data-grid-out="opacity"></output>
    </label>
    <label>
      <span>線寬</span>
      <input type="range" data-grid="width" min="0.5" max="2" step="0.5" />
      <output data-grid-out="width"></output>
    </label>
    <label>
      <span>斷口</span>
      <input type="range" data-grid="gap" min="0" max="8" step="1" />
      <output data-grid-out="gap"></output>
    </label>
    <label class="bottle-panel-wide">
      <span>顏色</span>
      <input type="color" data-grid="color" />
    </label>
    <label class="bottle-panel-wide">
      <span>樣式</span>
      <select data-grid="mode">
        <option value="dash">直線斷開</option>
        <option value="solid">實線</option>
        <option value="dot">點格</option>
      </select>
    </label>
    <label class="bottle-panel-check">
      <input type="checkbox" data-grid="marks" />
      <span>頁邊記號（延伸線與點）</span>
    </label>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="paper">
    <p class="bottle-panel-hint">紙色</p>
    <div class="bottle-panel-choices">
      <label><input type="radio" name="paper-color" value="#f5f3e6" />米白（目前）</label>
      <label><input type="radio" name="paper-color" value="#ffffff" />純白</label>
      <label><input type="radio" name="paper-color" value="#faf7ee" />象牙</label>
      <label><input type="radio" name="paper-color" value="#f1f1ee" />灰白</label>
      <label><input type="radio" name="paper-color" value="#ebe2cf" />牛皮</label>
      <label><input type="color" data-paper-custom />自訂</label>
    </div>
    <p class="bottle-panel-heading">光線（極淡的漸層）</p>
    <div class="bottle-panel-choices">
      <label><input type="radio" name="paper-light" value="" />無</label>
      <label><input type="radio" name="paper-light" value="morning" />晨光</label>
      <label><input type="radio" name="paper-light" value="dusk" />暮色</label>
      <label><input type="radio" name="paper-light" value="kiln" />窯火</label>
      <label><input type="radio" name="paper-light" value="celadon" />青瓷</label>
      <label><input type="radio" name="paper-light" value="vignette" />暈邊</label>
    </div>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="arrows">
    <p class="bottle-panel-hint">照片列的左右按鈕（只在滑鼠裝置出現；手機用滑的）</p>
    <div class="bottle-panel-choices">
      <label><input type="radio" name="arrows-variant" value="" />原本 [&gt;]</label>
      <label><input type="radio" name="arrows-variant" value="thin" />1 細箭頭</label>
      <label><input type="radio" name="arrows-variant" value="circle" />2 圓鈕</label>
      <label><input type="radio" name="arrows-variant" value="dots" />3 圓點</label>
      <label><input type="radio" name="arrows-variant" value="text" />4 文字</label>
      <label><input type="radio" name="arrows-variant" value="wrap" />5 不捲動</label>
    </div>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="header">
    <p class="bottle-panel-hint">捲下去比較停靠後的頁首</p>
    <div class="bottle-panel-choices">
      <label><input type="radio" name="header-variant" value="" />原本</label>
      <label><input type="radio" name="header-variant" value="lying" />1 橫躺</label>
      <label><input type="radio" name="header-variant" value="chip" />2 紙片</label>
      <label><input type="radio" name="header-variant" value="signed" />3 署名列</label>
      <label><input type="radio" name="header-variant" value="margin" />4 邊欄</label>
      <label><input type="radio" name="header-variant" value="reveal" />5 捲動隱藏</label>
      <label><input type="radio" name="header-variant" value="impressed" />6 壓印</label>
      <label><input type="radio" name="header-variant" value="disc" />7 圓紙片</label>
    </div>
    <p class="bottle-panel-heading">反白延伸</p>
    <div class="bottle-panel-choices">
      <label><input type="radio" name="header-variant" value="bbs" />反白</label>
      <label><input type="radio" name="header-variant" value="kiln" />a 窯窗</label>
      <label><input type="radio" name="header-variant" value="negative" />b 負片</label>
      <label><input type="radio" name="header-variant" value="seal" />c 陰刻印</label>
      <label><input type="radio" name="header-variant" value="giveway" />d 讓位</label>
      <label><input type="radio" name="header-variant" value="wetink" />e 墨未乾</label>
    </div>
  </section>
  <div class="bottle-panel-actions">
    <button type="button" data-reset>重設</button>
    <button type="button" data-copy>複製數值</button>
  </div>
</details>

<script is:inline>
  (() => {
    const KEY = "bottle-position";
    const stage = document.querySelector(".home-stage");
    const bottle = document.querySelector(".home-bottle");
    const panel = document.querySelector(".bottle-panel");
    if (!stage || !bottle || !panel) return;

    const narrow = matchMedia("(max-width: 48rem)");
    const mode = () => (narrow.matches ? "narrow" : "wide");
    const label = () => (narrow.matches ? "窄螢幕" : "寬螢幕");
    const props = {
      top: "--bottle-top",
      x: "--bottle-x",
      height: "--bottle-height",
      rotate: "--bottle-rotate",
      gap: "--hero-gap",
    };

    const read = () => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || "{}");
      } catch {
        return {};
      }
    };
    const write = (all) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(all));
      } catch {}
    };

    // The stylesheet's values for this breakpoint, read with no overrides.
    const defaults = () => {
      for (const prop of Object.values(props)) stage.style.removeProperty(prop);
      const style = getComputedStyle(stage);
      return {
        top: parseFloat(style.getPropertyValue("--bottle-top")),
        x: Math.round(parseFloat(style.getPropertyValue("--bottle-x")) * 100),
        height: parseFloat(style.getPropertyValue("--bottle-height")),
        rotate: parseFloat(style.getPropertyValue("--bottle-rotate")) || 0,
        gap: parseFloat(style.getPropertyValue("--hero-gap")) || 0,
        align: style.getPropertyValue("--greeting-align").trim() || "center",
      };
    };

    let current = {};
    const apply = () => {
      stage.style.setProperty("--bottle-top", `${current.top}dvh`);
      stage.style.setProperty("--bottle-x", `${current.x / 100}`);
      stage.style.setProperty("--bottle-height", `${current.height}dvh`);
      stage.style.setProperty("--bottle-rotate", `${current.rotate}deg`);
      stage.style.setProperty("--hero-gap", `${current.gap}px`);
      stage.style.setProperty("--greeting-align", current.align ?? "center");
      panel.querySelector("[data-align]").value = current.align ?? "center";
      for (const key of Object.keys(props)) {
        panel.querySelector(`[data-key="${key}"]`).value = current[key];
        panel.querySelector(`[data-out="${key}"]`).textContent =
          ({ x: "%", rotate: "deg", gap: "px" })[key]
            ? `${current[key]}${({ x: "%", rotate: "deg", gap: "px" })[key]}`
            : `${current[key]}dvh`;
      }
      panel.querySelector("[data-mode]").textContent = label();
    };
    const save = () => {
      const all = read();
      all[mode()] = { ...current };
      write(all);
    };
    const load = () => {
      current = { ...defaults(), ...(read()[mode()] || {}) };
      apply();
    };

    for (const input of panel.querySelectorAll("input[data-key]")) {
      input.addEventListener("input", () => {
        current[input.dataset.key] = Number(input.value);
        apply();
        save();
      });
    }

    panel.querySelector("[data-align]").addEventListener("change", (event) => {
      current.align = event.target.value;
      apply();
      save();
    });

    panel.querySelector("[data-reset]").addEventListener("click", () => {
      const all = read();
      delete all[mode()];
      delete all.logo;
      delete all.motion;
      delete all.paper;
      delete all.grid;
      write(all);
      panel.dispatchEvent(new Event("paper-reset"));
      load();
      loadLogo();
      loadMotion();
    });

    panel.querySelector("[data-copy]").addEventListener("click", async (event) => {
      const all = read();
      const line = (name, value) =>
        value
          ? `${name}　上 ${value.top}dvh　左 ${value.x}%　高 ${value.height}dvh　角度 ${value.rotate ?? 0}deg　右距 ${value.gap ?? "預設"}px　文字對齊 ${({ start: "上緣", center: "中間", end: "下緣" })[value.align] ?? "中間"}`
          : `${name}　未調整`;
      const logoLine = all.logo
        ? `Logo　上 ${all.logo.top}px　左 ${all.logo.left}px　角度 ${all.logo.rotate}deg　寬 ${all.logo.width}px`
        : "Logo　未調整";
      const m = all.motion;
      const motionLine = m
        ? `動畫　停靠 ${m.out}ms　返回 ${m.in}ms　門檻 ${m.threshold}px　變暗 ${m.darken}%　曲線 ${m.ease}　轉台 ${m.spin ? "開" : "關"}`
        : "動畫　未調整";
      const paperLine = all.paper
        ? `紙張　紙色 ${all.paper.color || DEFAULT_PAPER}　光線 ${all.paper.light || "無"}`
        : "紙張　未調整";
      const gr = all.grid;
      const gridLine = gr
        ? `格線　疏密 ${gr.cell}px　濃度 ${gr.opacity}%　線寬 ${gr.width}px　斷口 ${gr.gap}px　顏色 ${gr.color}　樣式 ${gr.mode}　頁邊記號 ${gr.marks ? "開" : "關"}`
        : "格線　未調整";
      const text = [line("寬螢幕", all.wide), line("窄螢幕", all.narrow), logoLine, motionLine, paperLine, gridLine].join("\n");
      try {
        await navigator.clipboard.writeText(text);
        event.target.textContent = "已複製";
        setTimeout(() => (event.target.textContent = "複製數值"), 1200);
      } catch {}
    });

    // Drag the bottle while the page is at the top, where it rests.
    let drag = null;
    let moved = false;
    bottle.addEventListener("pointerdown", (event) => {
      if (scrollY > 2) return;
      event.preventDefault();
      bottle.setPointerCapture(event.pointerId);
      drag = { x: event.clientX, y: event.clientY, top: current.top, left: current.x };
      moved = false;
    });
    bottle.addEventListener("pointermove", (event) => {
      if (!drag) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
      const shell = stage.getBoundingClientRect().width;
      current.top = Math.round(drag.top + (dy / innerHeight) * 100);
      current.x = Math.round(drag.left + (dx / shell) * 100);
      apply();
    });
    const end = () => {
      if (!drag) return;
      drag = null;
      save();
    };
    bottle.addEventListener("pointerup", end);
    bottle.addEventListener("pointercancel", end);
    // A drag is not a click on the home link.
    bottle.addEventListener(
      "click",
      (event) => {
        if (moved) {
          event.preventDefault();
          moved = false;
        }
      },
      true,
    );
    bottle.addEventListener("dragstart", (event) => event.preventDefault());

    // The logo's docked state: one set of values for every breakpoint.
    const root = document.documentElement;
    const logoProps = { top: "--logo-top", left: "--logo-left", rotate: "--logo-rotate", width: "--logo-width" };
    const logoUnits = { top: "px", left: "px", rotate: "deg", width: "px" };
    const logoDefaults = () => {
      // Read the stylesheet's own values, not a header candidate's.
      const header = root.dataset.header;
      delete root.dataset.header;
      for (const prop of Object.values(logoProps)) root.style.removeProperty(prop);
      const probe = document.createElement("div");
      probe.style.cssText =
        "position:absolute;visibility:hidden;top:var(--logo-top);left:var(--logo-left);width:var(--logo-width);rotate:var(--logo-rotate)";
      document.body.append(probe);
      const style = getComputedStyle(probe);
      const values = {
        top: Math.round(parseFloat(style.top)),
        left: Math.round(parseFloat(style.left)),
        rotate: Math.round(parseFloat(style.rotate)),
        width: Math.round(parseFloat(style.width)),
      };
      probe.remove();
      if (header) root.dataset.header = header;
      return values;
    };
    let logo = {};
    const applyLogo = () => {
      for (const key of Object.keys(logoProps)) {
        root.style.setProperty(logoProps[key], `${logo[key]}${logoUnits[key]}`);
        panel.querySelector(`[data-logo="${key}"]`).value = logo[key];
        panel.querySelector(`[data-logo-out="${key}"]`).textContent = `${logo[key]}${logoUnits[key]}`;
      }
    };
    const loadLogo = () => {
      const stored = read().logo;
      logo = { ...logoDefaults(), ...(stored || {}) };
      applyLogo();
      // Untouched sliders leave the stylesheet in charge.
      if (!stored) for (const prop of Object.values(logoProps)) root.style.removeProperty(prop);
    };
    for (const input of panel.querySelectorAll("input[data-logo]")) {
      input.addEventListener("input", () => {
        logo[input.dataset.logo] = Number(input.value);
        applyLogo();
        const all = read();
        all.logo = { ...logo };
        write(all);
      });
    }

    // The dock's motion: one set of values for every breakpoint.
    const EMIL = {
      out: 450,
      in: 550,
      threshold: 48,
      darken: 30,
      ease: "cubic-bezier(0.32, 0.72, 0, 1)",
      spin: true,
    };
    const motionVars = {
      out: ["--dock-out-duration", "ms"],
      in: ["--dock-in-duration", "ms"],
      threshold: ["--dock-threshold", "px"],
    };
    const motionDefaults = () => {
      for (const prop of ["--dock-out-duration", "--dock-in-duration", "--dock-threshold", "--dock-ease", "--dock-spin", "--dock-darken-from"]) {
        root.style.removeProperty(prop);
      }
      const style = getComputedStyle(root);
      const read = (name) => style.getPropertyValue(name).trim();
      return {
        out: parseFloat(read("--dock-out-duration")),
        in: parseFloat(read("--dock-in-duration")),
        threshold: parseFloat(read("--dock-threshold")),
        darken: Math.round(parseFloat(read("--dock-darken-from")) * 100),
        ease: read("--dock-ease"),
        spin: parseFloat(read("--dock-spin")) === 1,
      };
    };
    let motion = {};
    const applyMotion = () => {
      for (const [key, [prop, unit]] of Object.entries(motionVars)) {
        root.style.setProperty(prop, `${motion[key]}${unit}`);
      }
      root.style.setProperty("--dock-darken-from", `${motion.darken / 100}`);
      root.style.setProperty("--dock-ease", motion.ease);
      root.style.setProperty("--dock-spin", motion.spin ? "1" : "0");
      for (const key of ["out", "in", "threshold", "darken"]) {
        panel.querySelector(`[data-motion="${key}"]`).value = motion[key];
        panel.querySelector(`[data-motion-out="${key}"]`).textContent =
          key === "darken" ? `${motion[key]}%` : key === "threshold" ? `${motion[key]}px` : `${motion[key]}ms`;
      }
      const select = panel.querySelector('[data-motion="ease"]');
      if (![...select.options].some((option) => option.value === motion.ease)) {
        select.add(new Option(`目前：${motion.ease}`, motion.ease));
      }
      select.value = motion.ease;
      panel.querySelector('[data-motion="spin"]').checked = motion.spin;
    };
    const saveMotion = () => {
      const all = read();
      all.motion = { ...motion };
      write(all);
    };
    const loadMotion = () => {
      motion = { ...motionDefaults(), ...(read().motion || {}) };
      applyMotion();
    };
    for (const control of panel.querySelectorAll("[data-motion]")) {
      control.addEventListener(control.type === "range" ? "input" : "change", () => {
        const key = control.dataset.motion;
        motion[key] =
          control.type === "checkbox" ? control.checked : control.tagName === "SELECT" ? control.value : Number(control.value);
        applyMotion();
        saveMotion();
      });
    }
    panel.querySelector("[data-emil]").addEventListener("click", () => {
      motion = { ...EMIL };
      applyMotion();
      saveMotion();
    });

    // Which docked-header candidate to preview.
    const HEADER = "header-variant";
    const setHeader = (value) => {
      if (value) root.dataset.header = value;
      else delete root.dataset.header;
      for (const radio of panel.querySelectorAll('input[name="header-variant"]')) {
        radio.checked = radio.value === value;
      }
    };
    let header = "";
    try {
      header = localStorage.getItem(HEADER) || "";
    } catch {}
    setHeader(header);
    for (const radio of panel.querySelectorAll('input[name="header-variant"]')) {
      radio.addEventListener("change", () => {
        setHeader(radio.value);
        try {
          localStorage.setItem(HEADER, radio.value);
        } catch {}
      });
    }

    // Which photo-row button candidate to preview.
    const ARROWS = "arrows-variant";
    const setArrows = (value) => {
      if (value) root.dataset.arrows = value;
      else delete root.dataset.arrows;
      for (const radio of panel.querySelectorAll('input[name="arrows-variant"]')) {
        radio.checked = radio.value === value;
      }
    };
    let arrows = "";
    try {
      arrows = localStorage.getItem(ARROWS) || "";
    } catch {}
    setArrows(arrows);
    for (const radio of panel.querySelectorAll('input[name="arrows-variant"]')) {
      radio.addEventListener("change", () => {
        setArrows(radio.value);
        try {
          localStorage.setItem(ARROWS, radio.value);
        } catch {}
      });
    }

    // Which layout candidate to preview.
    const LAYOUT = "layout-variant";
    const setLayout = (value) => {
      if (value) root.dataset.layout = value;
      else delete root.dataset.layout;
      for (const radio of panel.querySelectorAll('input[name="layout-variant"]')) {
        radio.checked = radio.value === value;
      }
    };
    let layout = "";
    try {
      layout = localStorage.getItem(LAYOUT) || "";
    } catch {}
    setLayout(layout);
    for (const radio of panel.querySelectorAll('input[name="layout-variant"]')) {
      radio.addEventListener("change", () => {
        setLayout(radio.value);
        try {
          localStorage.setItem(LAYOUT, radio.value);
        } catch {}
      });
    }

    // Paper colour and light, kept with the other values.
    const DEFAULT_PAPER = "#f5f3e6";
    const applyPaper = (paper) => {
      if (paper.color && paper.color !== DEFAULT_PAPER) root.style.setProperty("--paper", paper.color);
      else root.style.removeProperty("--paper");
      if (paper.light) root.dataset.light = paper.light;
      else delete root.dataset.light;
      const color = paper.color || DEFAULT_PAPER;
      for (const radio of panel.querySelectorAll('input[name="paper-color"]')) {
        radio.checked = radio.value === color;
      }
      panel.querySelector("[data-paper-custom]").value = color;
      for (const radio of panel.querySelectorAll('input[name="paper-light"]')) {
        radio.checked = radio.value === (paper.light || "");
      }
    };
    let paper = { ...(read().paper || {}) };
    const savePaper = () => {
      const all = read();
      all.paper = { ...paper };
      write(all);
      applyPaper(paper);
    };
    applyPaper(paper);
    panel.addEventListener("paper-reset", () => {
      paper = {};
      applyPaper(paper);
    });
    for (const radio of panel.querySelectorAll('input[name="paper-color"]')) {
      radio.addEventListener("change", () => {
        paper.color = radio.value;
        savePaper();
      });
    }
    panel.querySelector("[data-paper-custom]").addEventListener("input", (event) => {
      paper.color = event.target.value;
      savePaper();
    });
    for (const radio of panel.querySelectorAll('input[name="paper-light"]')) {
      radio.addEventListener("change", () => {
        paper.light = radio.value;
        savePaper();
      });
    }

    // The ruling: rebuilt as SVG cells from the chosen values.
    const GRID_DEFAULTS = { cell: 20, opacity: 11, width: 1, gap: 3, color: "#141414", mode: "dash", marks: true };
    const svgUrl = (body, cell) =>
      `url("data:image/svg+xml,${encodeURIComponent(
        `<svg xmlns='http://www.w3.org/2000/svg' width='${cell}' height='${cell}'>${body}</svg>`,
      )}")`;
    const applyGrid = (grid, write) => {
      const g = { ...GRID_DEFAULTS, ...grid };
      const stroke = `stroke='${g.color}' stroke-opacity='${g.opacity / 100}' stroke-width='${g.width}'`;
      const half = g.width / 2;
      const top = g.mode === "solid" ? 0 : g.gap;
      const bottom = g.mode === "solid" ? g.cell : g.cell - Math.max(0, g.gap - 1);
      const cellBody =
        g.mode === "dot"
          ? `<circle cx='${half + 0.5}' cy='${half + 0.5}' r='${g.width}' fill='${g.color}' fill-opacity='${Math.min(1, (g.opacity / 100) * 2)}'/>`
          : `<path d='M0 ${half}H${g.cell}' ${stroke}/><path d='M${half} ${top}V${bottom}' ${stroke}/>`;
      const edgeBody = g.mode === "dot" ? "" : `<path d='M${g.cell - half} ${top}V${bottom}' ${stroke}/>`;
      if (write) {
        root.style.setProperty("--grid", `${g.cell}px`);
        root.style.setProperty("--grid-cell", svgUrl(cellBody, g.cell));
        root.style.setProperty("--grid-edge", svgUrl(edgeBody, g.cell));
        const [r, gr, b] = [1, 3, 5].map((i) => parseInt(g.color.slice(i, i + 2), 16));
        root.style.setProperty("--grid-line", `rgb(${r} ${gr} ${b} / ${g.opacity}%)`);
        if (g.marks) delete root.dataset.marks;
        else root.dataset.marks = "off";
      } else {
        for (const prop of ["--grid", "--grid-cell", "--grid-edge", "--grid-line"]) root.style.removeProperty(prop);
        delete root.dataset.marks;
      }
      for (const key of ["cell", "opacity", "width", "gap"]) {
        panel.querySelector(`[data-grid="${key}"]`).value = g[key];
        panel.querySelector(`[data-grid-out="${key}"]`).textContent =
          key === "opacity" ? `${g[key]}%` : `${g[key]}px`;
      }
      panel.querySelector('[data-grid="color"]').value = g.color;
      panel.querySelector('[data-grid="mode"]').value = g.mode;
      panel.querySelector('[data-grid="marks"]').checked = g.marks;
    };
    let grid = read().grid || null;
    applyGrid(grid || {}, Boolean(grid));
    for (const control of panel.querySelectorAll("[data-grid]")) {
      const event = control.type === "range" || control.type === "color" ? "input" : "change";
      control.addEventListener(event, () => {
        const key = control.dataset.grid;
        grid = { ...GRID_DEFAULTS, ...(grid || {}) };
        grid[key] =
          control.type === "checkbox" ? control.checked : control.type === "range" ? Number(control.value) : control.value;
        const all = read();
        all.grid = grid;
        write(all);
        applyGrid(grid, true);
      });
    }
    panel.addEventListener("paper-reset", () => {
      grid = null;
      applyGrid({}, false);
    });

    // Which post-date style to preview.
    const DATE = "date-variant";
    const setDate = (value) => {
      if (value) root.dataset.date = value;
      else delete root.dataset.date;
      for (const radio of panel.querySelectorAll('input[name="date-variant"]')) {
        radio.checked = radio.value === value;
      }
    };
    let dateStyle = "";
    try {
      dateStyle = localStorage.getItem(DATE) || "";
    } catch {}
    setDate(dateStyle);
    for (const radio of panel.querySelectorAll('input[name="date-variant"]')) {
      radio.addEventListener("change", () => {
        setDate(radio.value);
        try {
          localStorage.setItem(DATE, radio.value);
        } catch {}
      });
    }

    // Tabs keep the panel short; the last one opened is remembered.
    const TAB = "bottle-panel-tab";
    const showTab = (name) => {
      for (const tab of panel.querySelectorAll("[data-tab]")) {
        tab.setAttribute("aria-selected", String(tab.dataset.tab === name));
      }
      for (const section of panel.querySelectorAll("[data-panel]")) {
        section.hidden = section.dataset.panel !== name;
      }
      try {
        localStorage.setItem(TAB, name);
      } catch {}
    };
    let tab = "bottle";
    try {
      tab = localStorage.getItem(TAB) || "bottle";
    } catch {}
    showTab(tab);
    for (const button of panel.querySelectorAll("[data-tab]")) {
      button.addEventListener("click", () => showTab(button.dataset.tab));
    }

    narrow.addEventListener("change", load);
    load();
    loadLogo();
    loadMotion();
  })();
</script>

<style>
  .bottle-panel {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 30;
    width: 16rem;
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 96%);
    box-shadow: 0 6px 24px rgb(0 0 0 / 14%);
    font-size: 0.8125rem;
  }

  .bottle-panel summary {
    cursor: pointer;
    color: var(--ink-muted);
  }

  .bottle-panel label {
    display: grid;
    grid-template-columns: 2rem 1fr 4rem;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.25rem;
  }

  .bottle-panel input {
    width: 100%;
    accent-color: var(--ribbon);
  }

  .bottle-panel output {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .bottle-panel-hint {
    margin: 0.25rem 0 0.5rem;
    color: var(--ink-muted);
  }

  .bottle-panel-heading {
    margin: 0.75rem 0 0;
    color: var(--ink-muted);
  }


  .bottle-panel-wide {
    grid-template-columns: 2rem 1fr;
  }

  .bottle-panel select {
    width: 100%;
    min-height: 2rem;
    font: inherit;
  }

  .bottle-panel-check {
    grid-template-columns: auto 1fr;
  }

  .bottle-panel-check input {
    width: auto;
  }

  .bottle-panel-tabs {
    display: flex;
    gap: 0.25rem;
    margin: 0.5rem 0 0.25rem;
  }

  .bottle-panel .bottle-panel-tabs button {
    flex: 1;
    min-height: 2rem;
    padding: 0;
    border-color: transparent;
    color: var(--ink-muted);
  }

  .bottle-panel .bottle-panel-tabs button[aria-selected="true"] {
    border-color: var(--ink);
    color: var(--ink);
  }

  .bottle-panel-section {
    padding-block: 0.25rem;
  }

  .bottle-panel-choices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 0.5rem;
  }

  .bottle-panel-choices label {
    display: flex;
    gap: 0.4rem;
    min-height: 1.75rem;
  }

  .bottle-panel-choices input {
    width: auto;
  }

  .bottle-panel-actions {
    display: flex;
    gap: 1ch;
  }

  .bottle-panel button {
    min-height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--ink-muted);
    border-radius: 0.25rem;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }

  :global(.home-bottle) {
    cursor: grab;
    touch-action: none;
  }

  /* ---------- Docked header candidates (dev only) ---------- */
  @supports (animation-timeline: scroll()) {
    /* The shell's left edge, for the paper behind the mark. */
    :global(html[data-header] .home-stage) {
      --edge: calc((100vw - var(--shell-width-vw)) / 2);
    }

    /* 1: the mark lies on its side, so the band is only as tall as the
       bottle is wide. */
    /* !important only to win over the panel's own logo sliders, which
       write inline styles on the root. */
    :global(html[data-header="lying"]) {
      --logo-rotate: -90deg !important;
      --logo-top: calc(12px - (var(--logo-height) - var(--logo-width)) / 2) !important;
      --logo-left: calc((var(--logo-height) - var(--logo-width)) / 2) !important;
    }

    :global(html[data-header="lying"] .home-stage::before) {
      height: calc(var(--logo-width) + 24px);
    }

    /* 2: no band; a small patch of paper behind the mark only. The
       reverse-video candidates below dress the same patch. */
    :global(html[data-header="chip"] .home-stage::before),
    :global(html[data-header="margin"] .home-stage::before),
    :global(html[data-header="bbs"] .home-stage::before),
    :global(html[data-header="impressed"] .home-stage::before),
    :global(html[data-header="kiln"] .home-stage::before),
    :global(html[data-header="negative"] .home-stage::before),
    :global(html[data-header="seal"] .home-stage::before),
    :global(html[data-header="giveway"] .home-stage::before),
    :global(html[data-header="wetink"] .home-stage::before) {
      inset: auto;
      top: calc(var(--logo-top) - 8px);
      left: calc(var(--edge) + var(--logo-left) - 8px);
      width: calc(var(--logo-width) + 16px);
      height: calc(var(--logo-height) + 16px);
    }

    /* 7: the paper patch as a disc, centred on the mark (nudged in from the
       screen edge on narrow screens, where the mark sits close to it). */
    :global(html[data-header="disc"] .home-stage::before) {
      --disc: calc(var(--logo-height) + var(--grid));
      inset: auto;
      top: calc(var(--logo-top) + var(--logo-height) / 2 - var(--disc) / 2);
      left: max(4px, var(--edge) + var(--logo-left) + var(--logo-width) / 2 - var(--disc) / 2);
      width: var(--disc);
      height: var(--disc);
      border-radius: 50%;
    }

    /* 6: impressed, like a potter's stamp pressed into soft clay: the patch
       is a recess in the page, shadowed along its top inner edge with a
       light lip below, and the mark sits in it. (Breaks the Flat Paper
       Rule on purpose; a candidate only.) */
    :global(html[data-header="impressed"] .home-stage::before) {
      background: rgb(238 238 238);
      box-shadow:
        inset 0 3px 6px rgb(20 20 20 / 38%),
        inset 2px 0 4px rgb(20 20 20 / 14%),
        inset 0 -1px 0 rgb(255 255 255 / 95%);
    }

    /* Reverse video (BBS): the mark as a highlighted cell. */
    :global(html[data-header="bbs"] .home-stage::before) {
      background: var(--ink);
    }

    @container style(--docked: 1) {
      :global(html[data-header="bbs"] .home-bottle),
      :global(html[data-header="kiln"] .home-bottle),
      :global(html[data-header="negative"] .home-bottle),
      :global(html[data-header="seal"] .home-bottle),
      :global(html[data-header="giveway"] .home-bottle),
      :global(html[data-header="wetink"] .home-bottle) {
        color: var(--paper);
      }
    }

    /* Reverse video, five ways. Blur and opacity serve each idea. */

    /* a: the kiln's spy hole: smoked glass, the page behind it hazy, the
       bottle inside lit white. */
    :global(html[data-header="kiln"] .home-stage::before) {
      background: rgb(20 20 20 / 80%);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }

    /* b: a frame of film negative laid over the page: what lies under it
       turns negative and slightly out of focus. */
    :global(html[data-header="negative"] .home-stage::before) {
      background: transparent;
      -webkit-backdrop-filter: invert(1) grayscale(1) blur(1.5px);
      backdrop-filter: invert(1) grayscale(1) blur(1.5px);
    }

    /* c: a carved seal (陰刻), the potter's chop in red with the bottle cut
       out; its edge softened as ink soaks into paper. */
    :global(html[data-header="seal"] .home-stage::before) {
      background: var(--ribbon);
      opacity: calc(var(--docked) * 0.92);
      filter: blur(0.4px);
    }

    /* d: gives way while reading: faint and soft scrolling down, sharp the
       moment the reader scrolls back up. */
    :global(html[data-header="giveway"]) {
      container-type: scroll-state;
    }

    :global(html[data-header="giveway"] .home-stage::before) {
      background: var(--ink);
      transition:
        opacity 300ms ease-out,
        filter 300ms ease-out;
    }

    @container scroll-state(scrolled: bottom) {
      @container style(--docked: 1) {
        :global(html[data-header="giveway"] .home-bottle) {
          opacity: 0.4;
          filter: blur(1.5px);
        }
      }

      :global(html[data-header="giveway"] .home-stage::before) {
        opacity: calc(var(--docked) * 0.22);
        filter: blur(1.5px);
      }
    }

    :global(html[data-header="giveway"] .home-bottle) {
      transition-property: translate, scale, top, rotate, color, --dock-t, opacity, filter;
      transition-duration: var(--dock-duration), var(--dock-duration), var(--dock-duration),
        var(--dock-duration), 120ms, var(--dock-duration), 300ms, 300ms;
    }

    /* e: ink not yet dry: the patch lands soft and spreads, then sets
       sharp. */
    :global(html[data-header="wetink"] .home-stage::before) {
      background: var(--ink);
      filter: blur(calc((1 - var(--docked)) * 8px));
      transition:
        opacity 250ms ease-out,
        filter 700ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    /* 3: the band carries the name, like the article header. */
    :global(html[data-header="signed"] .home-stage::before) {
      height: calc(var(--logo-height) + 2 * var(--logo-top));
      padding-inline-start: calc(var(--edge) + var(--logo-left) + var(--logo-width) + 1.75rem);
      color: var(--ink);
      font-size: var(--type-size);
      letter-spacing: 0.08em;
      line-height: calc(var(--logo-height) + 2 * var(--logo-top));
      content: "李至青";
    }

    /* 4: on wide screens the mark sits in the empty left margin, so nothing
       covers the text; phones have no margin and keep the patch. */
    @media (min-width: 48.0625rem) {
      :global(html[data-header="margin"]) {
        --logo-left: calc(-1 * var(--logo-width) - 1.25rem) !important;
      }

      :global(html[data-header="margin"] .home-stage::before) {
        display: none;
      }
    }

    /* 5: band and mark step aside while reading down, and return the
       moment the reader scrolls back up. */
    :global(html[data-header="reveal"]) {
      container-type: scroll-state;
    }

    @container scroll-state(scrolled: bottom) {
      :global(html[data-header="reveal"] .home-stage::before) {
        opacity: 0;
      }

      /* Only the docked mark steps aside, never the hero bottle. */
      @container style(--docked: 1) {
        :global(html[data-header="reveal"] .home-bottle) {
          opacity: 0;
          pointer-events: none;
        }
      }
    }

    :global(html[data-header="reveal"] .home-bottle) {
      transition-property: translate, scale, top, rotate, color, --dock-t, opacity;
      transition-duration: var(--dock-duration), var(--dock-duration), var(--dock-duration),
        var(--dock-duration), 120ms, var(--dock-duration), 200ms;
    }
  }

  /* ---------- Photo-row button candidates (dev only) ---------- */
  @supports selector(::scroll-button(*)) {
    @media (pointer: fine) {
      /* 1: bare arrows beside the row: in the page margin when there is
         room, otherwise just inside the row's ends on a sliver of paper. */
      :global(html[data-arrows="thin"] .diary-photos::scroll-button(*)) {
        min-width: 2rem;
        padding-inline: 0;
        background: var(--paper);
        color: var(--ink);
        font-size: 1.5rem;
        line-height: 1;
      }

      :global(html[data-arrows="thin"] .diary-photos::scroll-button(left)) {
        content: "←" / "上一張";
        left: max(0px, calc(anchor(left) - 2.5rem));
      }

      :global(html[data-arrows="thin"] .diary-photos::scroll-button(right)) {
        content: "→" / "下一張";
        right: max(0px, calc(anchor(right) - 2.5rem));
      }

      /* 2: paper discs over the photo edges. */
      :global(html[data-arrows="circle"] .diary-photos::scroll-button(*)) {
        width: 2.5rem;
        min-width: 0;
        height: 2.5rem;
        padding: 0;
        border: 1px solid var(--ink-muted);
        border-radius: 50%;
        font-size: 1.5rem;
        line-height: 1;
      }

      :global(html[data-arrows="circle"] .diary-photos::scroll-button(left)) {
        content: "‹" / "上一張";
        left: calc(anchor(left) + 0.75rem);
      }

      :global(html[data-arrows="circle"] .diary-photos::scroll-button(right)) {
        content: "›" / "下一張";
        right: calc(anchor(right) + 0.75rem);
      }

      /* 3: no arrows; one dot per photo under the row, the current one red. */
      :global(html[data-arrows="dots"] .diary-photos::scroll-button(*)),
      :global(html[data-arrows="wrap"] .diary-photos::scroll-button(*)) {
        content: none;
      }

      :global(html[data-arrows="dots"] .diary-photos) {
        scroll-marker-group: after;
      }

      :global(html[data-arrows="dots"] .diary-photos::scroll-marker-group) {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        padding-top: 0.75rem;
      }

      :global(html[data-arrows="dots"] .diary-photo::scroll-marker) {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--ink-muted);
        opacity: 0.35;
        content: "";
      }

      :global(html[data-arrows="dots"] .diary-photo::scroll-marker:target-current) {
        background: var(--ribbon);
        opacity: 1;
      }

      /* 4: words under the row, at its two ends. */
      :global(html[data-arrows="text"] .diary-photos::scroll-button(*)) {
        top: anchor(bottom);
        translate: none;
        height: 2.25rem;
        background: transparent;
        color: var(--ribbon);
      }

      :global(html[data-arrows="text"] .diary-photos::scroll-button(left)) {
        content: "← 上一張";
        left: anchor(left);
      }

      :global(html[data-arrows="text"] .diary-photos::scroll-button(right)) {
        content: "下一張 →";
        right: anchor(right);
      }

      /* 5: no scrolling row on desktop; every photo shows, wrapped. */
      :global(html[data-arrows="wrap"] .diary-photos) {
        flex-wrap: wrap;
        overflow-x: visible;
      }
    }
  }

  /* ---------- Ruling candidates (dev only) ----------
     Only the grid changes; it alone shows what belongs together. */

  /* 1: the ruling prints only under each block; between blocks the paper
     is plain. A paper outline hides the shared grid around each block, so
     every patch stays on the same ruling. */
  /* Outlines paint over later content, so every gap is at least two
     outlines wide. */
  :global(html[data-layout="broken"] .diary-feed),
  :global(html[data-layout="broken"] .home-flow) {
    gap: calc(var(--grid) * 4);
  }

  :global(html[data-layout="broken"] .home-hero),
  :global(html[data-layout="broken"] .diary-entry) {
    outline: calc(var(--grid) * 2) solid var(--paper);
  }

  /* 2: manuscript paper (原稿紙): the diary text sits one CJK character
     per cell, one line per row. Half-width characters take half a cell. */
  :global(html[data-layout="manuscript"] .diary-text) {
    --cell: 26px;
    width: round(down, 100%, var(--cell));
