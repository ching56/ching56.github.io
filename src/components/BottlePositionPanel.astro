---
// Dev-only tool for placing the homepage bottle at rest and the logo it docks
// into. Drag the bottle at the top of the page, or use the sliders. Bottle
// values are kept per breakpoint, logo values once, in localStorage
// ("bottle-position") so they survive reloads and can be read back and
// written into global.css. Never rendered in production.
---

<details class="bottle-panel" open>
  <summary>調整面板　<span data-mode></span></summary>
  <div class="bottle-panel-tabs" role="tablist">
    <button type="button" role="tab" data-tab="bottle">瓶子</button>
    <button type="button" role="tab" data-tab="logo">Logo</button>
    <button type="button" role="tab" data-tab="motion">動畫</button>
    <button type="button" role="tab" data-tab="header">頁首</button>
  </div>
  <section class="bottle-panel-section" role="tabpanel" data-panel="bottle">
    <label>
      <span>上</span>
      <input type="range" data-key="top" min="-20" max="80" step="1" />
      <output data-out="top"></output>
    </label>
    <label>
      <span>左</span>
      <input type="range" data-key="x" min="-20" max="90" step="1" />
      <output data-out="x"></output>
    </label>
    <label>
      <span>高</span>
      <input type="range" data-key="height" min="10" max="240" step="1" />
      <output data-out="height"></output>
    </label>
    <label>
      <span>角度</span>
      <input type="range" data-key="rotate" min="-90" max="90" step="1" />
      <output data-out="rotate"></output>
    </label>
    <label>
      <span>右距</span>
      <input type="range" data-key="gap" min="0" max="160" step="1" />
      <output data-out="gap"></output>
    </label>
    <label class="bottle-panel-wide">
      <span>文字</span>
      <select data-align>
        <option value="start">對齊瓶子上緣</option>
        <option value="center">對齊瓶子中間</option>
        <option value="end">對齊瓶子下緣</option>
      </select>
    </label>
    <p class="bottle-panel-hint">在頁面最上方直接拖曳瓶子</p>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="logo">
    <p class="bottle-panel-hint">捲到 logo 停靠後再調</p>
    <label>
      <span>上</span>
      <input type="range" data-logo="top" min="0" max="80" step="1" />
      <output data-logo-out="top"></output>
    </label>
    <label>
      <span>左</span>
      <input type="range" data-logo="left" min="-20" max="120" step="1" />
      <output data-logo-out="left"></output>
    </label>
    <label>
      <span>角度</span>
      <input type="range" data-logo="rotate" min="-180" max="180" step="1" />
      <output data-logo-out="rotate"></output>
    </label>
    <label>
      <span>寬</span>
      <input type="range" data-logo="width" min="12" max="80" step="1" />
      <output data-logo-out="width"></output>
    </label>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="motion">
    <p class="bottle-panel-hint">捲過門檻看效果</p>
    <label>
      <span>停靠</span>
      <input type="range" data-motion="out" min="100" max="1500" step="10" />
      <output data-motion-out="out"></output>
    </label>
    <label>
      <span>返回</span>
      <input type="range" data-motion="in" min="100" max="1500" step="10" />
      <output data-motion-out="in"></output>
    </label>
    <label>
      <span>門檻</span>
      <input type="range" data-motion="threshold" min="0" max="300" step="2" />
      <output data-motion-out="threshold"></output>
    </label>
    <label>
      <span>變暗</span>
      <input type="range" data-motion="darken" min="0" max="90" step="5" />
      <output data-motion-out="darken"></output>
    </label>
    <label class="bottle-panel-wide">
      <span>曲線</span>
      <select data-motion="ease">
        <option value="cubic-bezier(0.77, 0, 0.175, 1)">Emil ease-in-out</option>
        <option value="cubic-bezier(0.32, 0.72, 0, 1)">iOS drawer</option>
        <option value="cubic-bezier(0.23, 1, 0.32, 1)">Emil ease-out</option>
        <option value="cubic-bezier(0.65, 0, 0.35, 1)">柔和 in-out</option>
        <option value="linear">linear（對照）</option>
      </select>
    </label>
    <label class="bottle-panel-check">
      <input type="checkbox" data-motion="spin" />
      <span>停靠時轉台轉一圈</span>
    </label>
    <div class="bottle-panel-actions">
      <button type="button" data-emil>套用 Emil 建議</button>
    </div>
  </section>
  <section class="bottle-panel-section" role="tabpanel" data-panel="header">
    <p class="bottle-panel-hint">捲下去比較停靠後的頁首</p>
    <div class="bottle-panel-choices">
      <label><input type="radio" name="header-variant" value="" />原本</label>
      <label><input type="radio" name="header-variant" value="lying" />1 橫躺</label>
      <label><input type="radio" name="header-variant" value="chip" />2 紙片</label>
      <label><input type="radio" name="header-variant" value="signed" />3 署名列</label>
      <label><input type="radio" name="header-variant" value="margin" />4 邊欄</label>
      <label><input type="radio" name="header-variant" value="reveal" />5 捲動隱藏</label>
    </div>
  </section>
  <div class="bottle-panel-actions">
    <button type="button" data-reset>重設</button>
    <button type="button" data-copy>複製數值</button>
  </div>
</details>

<script is:inline>
  (() => {
    const KEY = "bottle-position";
    const stage = document.querySelector(".home-stage");
    const bottle = document.querySelector(".home-bottle");
    const panel = document.querySelector(".bottle-panel");
    if (!stage || !bottle || !panel) return;

    const narrow = matchMedia("(max-width: 48rem)");
    const mode = () => (narrow.matches ? "narrow" : "wide");
    const label = () => (narrow.matches ? "窄螢幕" : "寬螢幕");
    const props = {
      top: "--bottle-top",
      x: "--bottle-x",
      height: "--bottle-height",
      rotate: "--bottle-rotate",
      gap: "--hero-gap",
    };

    const read = () => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || "{}");
      } catch {
        return {};
      }
    };
    const write = (all) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(all));
      } catch {}
    };

    // The stylesheet's values for this breakpoint, read with no overrides.
    const defaults = () => {
      for (const prop of Object.values(props)) stage.style.removeProperty(prop);
      const style = getComputedStyle(stage);
      return {
        top: parseFloat(style.getPropertyValue("--bottle-top")),
        x: Math.round(parseFloat(style.getPropertyValue("--bottle-x")) * 100),
        height: parseFloat(style.getPropertyValue("--bottle-height")),
        rotate: parseFloat(style.getPropertyValue("--bottle-rotate")) || 0,
        gap: parseFloat(style.getPropertyValue("--hero-gap")) || 0,
        align: style.getPropertyValue("--greeting-align").trim() || "center",
      };
    };

    let current = {};
    const apply = () => {
      stage.style.setProperty("--bottle-top", `${current.top}dvh`);
      stage.style.setProperty("--bottle-x", `${current.x / 100}`);
      stage.style.setProperty("--bottle-height", `${current.height}dvh`);
      stage.style.setProperty("--bottle-rotate", `${current.rotate}deg`);
      stage.style.setProperty("--hero-gap", `${current.gap}px`);
      stage.style.setProperty("--greeting-align", current.align ?? "center");
      panel.querySelector("[data-align]").value = current.align ?? "center";
      for (const key of Object.keys(props)) {
        panel.querySelector(`[data-key="${key}"]`).value = current[key];
        panel.querySelector(`[data-out="${key}"]`).textContent =
          ({ x: "%", rotate: "deg", gap: "px" })[key]
            ? `${current[key]}${({ x: "%", rotate: "deg", gap: "px" })[key]}`
            : `${current[key]}dvh`;
      }
      panel.querySelector("[data-mode]").textContent = label();
    };
    const save = () => {
      const all = read();
      all[mode()] = { ...current };
      write(all);
    };
    const load = () => {
      current = { ...defaults(), ...(read()[mode()] || {}) };
      apply();
    };

    for (const input of panel.querySelectorAll("input[data-key]")) {
      input.addEventListener("input", () => {
        current[input.dataset.key] = Number(input.value);
        apply();
        save();
      });
    }

    panel.querySelector("[data-align]").addEventListener("change", (event) => {
      current.align = event.target.value;
      apply();
      save();
    });

    panel.querySelector("[data-reset]").addEventListener("click", () => {
      const all = read();
      delete all[mode()];
      delete all.logo;
      delete all.motion;
      write(all);
      load();
      loadLogo();
      loadMotion();
    });

    panel.querySelector("[data-copy]").addEventListener("click", async (event) => {
      const all = read();
      const line = (name, value) =>
        value
          ? `${name}　上 ${value.top}dvh　左 ${value.x}%　高 ${value.height}dvh　角度 ${value.rotate ?? 0}deg　右距 ${value.gap ?? "預設"}px　文字對齊 ${({ start: "上緣", center: "中間", end: "下緣" })[value.align] ?? "中間"}`
          : `${name}　未調整`;
      const logoLine = all.logo
        ? `Logo　上 ${all.logo.top}px　左 ${all.logo.left}px　角度 ${all.logo.rotate}deg　寬 ${all.logo.width}px`
        : "Logo　未調整";
      const m = all.motion;
      const motionLine = m
        ? `動畫　停靠 ${m.out}ms　返回 ${m.in}ms　門檻 ${m.threshold}px　變暗 ${m.darken}%　曲線 ${m.ease}　轉台 ${m.spin ? "開" : "關"}`
        : "動畫　未調整";
      const text = [line("寬螢幕", all.wide), line("窄螢幕", all.narrow), logoLine, motionLine].join("\n");
      try {
        await navigator.clipboard.writeText(text);
        event.target.textContent = "已複製";
        setTimeout(() => (event.target.textContent = "複製數值"), 1200);
      } catch {}
    });

    // Drag the bottle while the page is at the top, where it rests.
    let drag = null;
    let moved = false;
    bottle.addEventListener("pointerdown", (event) => {
      if (scrollY > 2) return;
      event.preventDefault();
      bottle.setPointerCapture(event.pointerId);
      drag = { x: event.clientX, y: event.clientY, top: current.top, left: current.x };
      moved = false;
    });
    bottle.addEventListener("pointermove", (event) => {
      if (!drag) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
      const shell = stage.getBoundingClientRect().width;
      current.top = Math.round(drag.top + (dy / innerHeight) * 100);
      current.x = Math.round(drag.left + (dx / shell) * 100);
      apply();
    });
    const end = () => {
      if (!drag) return;
      drag = null;
      save();
    };
    bottle.addEventListener("pointerup", end);
    bottle.addEventListener("pointercancel", end);
    // A drag is not a click on the home link.
    bottle.addEventListener(
      "click",
      (event) => {
        if (moved) {
          event.preventDefault();
          moved = false;
        }
      },
      true,
    );
    bottle.addEventListener("dragstart", (event) => event.preventDefault());

    // The logo's docked state: one set of values for every breakpoint.
    const root = document.documentElement;
    const logoProps = { top: "--logo-top", left: "--logo-left", rotate: "--logo-rotate", width: "--logo-width" };
    const logoUnits = { top: "px", left: "px", rotate: "deg", width: "px" };
    const logoDefaults = () => {
      for (const prop of Object.values(logoProps)) root.style.removeProperty(prop);
      const probe = document.createElement("div");
      probe.style.cssText =
        "position:absolute;visibility:hidden;top:var(--logo-top);left:var(--logo-left);width:var(--logo-width);rotate:var(--logo-rotate)";
      document.body.append(probe);
      const style = getComputedStyle(probe);
      const values = {
        top: Math.round(parseFloat(style.top)),
        left: Math.round(parseFloat(style.left)),
        rotate: Math.round(parseFloat(style.rotate)),
        width: Math.round(parseFloat(style.width)),
      };
      probe.remove();
      return values;
    };
    let logo = {};
    const applyLogo = () => {
      for (const key of Object.keys(logoProps)) {
        root.style.setProperty(logoProps[key], `${logo[key]}${logoUnits[key]}`);
        panel.querySelector(`[data-logo="${key}"]`).value = logo[key];
        panel.querySelector(`[data-logo-out="${key}"]`).textContent = `${logo[key]}${logoUnits[key]}`;
      }
    };
    const loadLogo = () => {
      logo = { ...logoDefaults(), ...(read().logo || {}) };
      applyLogo();
    };
    for (const input of panel.querySelectorAll("input[data-logo]")) {
      input.addEventListener("input", () => {
        logo[input.dataset.logo] = Number(input.value);
        applyLogo();
        const all = read();
        all.logo = { ...logo };
        write(all);
      });
    }

    // The dock's motion: one set of values for every breakpoint.
    const EMIL = {
      out: 450,
      in: 550,
      threshold: 48,
      darken: 30,
      ease: "cubic-bezier(0.32, 0.72, 0, 1)",
      spin: true,
    };
    const motionVars = {
      out: ["--dock-out-duration", "ms"],
      in: ["--dock-in-duration", "ms"],
      threshold: ["--dock-threshold", "px"],
    };
    const motionDefaults = () => {
      for (const prop of ["--dock-out-duration", "--dock-in-duration", "--dock-threshold", "--dock-ease", "--dock-spin", "--dock-darken-from"]) {
        root.style.removeProperty(prop);
      }
      const style = getComputedStyle(root);
      const read = (name) => style.getPropertyValue(name).trim();
      return {
        out: parseFloat(read("--dock-out-duration")),
        in: parseFloat(read("--dock-in-duration")),
        threshold: parseFloat(read("--dock-threshold")),
        darken: Math.round(parseFloat(read("--dock-darken-from")) * 100),
        ease: read("--dock-ease"),
        spin: parseFloat(read("--dock-spin")) === 1,
      };
    };
    let motion = {};
    const applyMotion = () => {
      for (const [key, [prop, unit]] of Object.entries(motionVars)) {
        root.style.setProperty(prop, `${motion[key]}${unit}`);
      }
      root.style.setProperty("--dock-darken-from", `${motion.darken / 100}`);
      root.style.setProperty("--dock-ease", motion.ease);
      root.style.setProperty("--dock-spin", motion.spin ? "1" : "0");
      for (const key of ["out", "in", "threshold", "darken"]) {
        panel.querySelector(`[data-motion="${key}"]`).value = motion[key];
        panel.querySelector(`[data-motion-out="${key}"]`).textContent =
          key === "darken" ? `${motion[key]}%` : key === "threshold" ? `${motion[key]}px` : `${motion[key]}ms`;
      }
      const select = panel.querySelector('[data-motion="ease"]');
      if (![...select.options].some((option) => option.value === motion.ease)) {
        select.add(new Option(`目前：${motion.ease}`, motion.ease));
      }
      select.value = motion.ease;
      panel.querySelector('[data-motion="spin"]').checked = motion.spin;
    };
    const saveMotion = () => {
      const all = read();
      all.motion = { ...motion };
      write(all);
    };
    const loadMotion = () => {
      motion = { ...motionDefaults(), ...(read().motion || {}) };
      applyMotion();
    };
    for (const control of panel.querySelectorAll("[data-motion]")) {
      control.addEventListener(control.type === "range" ? "input" : "change", () => {
        const key = control.dataset.motion;
        motion[key] =
          control.type === "checkbox" ? control.checked : control.tagName === "SELECT" ? control.value : Number(control.value);
        applyMotion();
        saveMotion();
      });
    }
    panel.querySelector("[data-emil]").addEventListener("click", () => {
      motion = { ...EMIL };
      applyMotion();
      saveMotion();
    });

    // Which docked-header candidate to preview.
    const HEADER = "header-variant";
    const setHeader = (value) => {
      if (value) root.dataset.header = value;
      else delete root.dataset.header;
      for (const radio of panel.querySelectorAll('input[name="header-variant"]')) {
        radio.checked = radio.value === value;
      }
    };
    let header = "";
    try {
      header = localStorage.getItem(HEADER) || "";
    } catch {}
    setHeader(header);
    for (const radio of panel.querySelectorAll('input[name="header-variant"]')) {
      radio.addEventListener("change", () => {
        setHeader(radio.value);
        try {
          localStorage.setItem(HEADER, radio.value);
        } catch {}
      });
    }

    // Tabs keep the panel short; the last one opened is remembered.
    const TAB = "bottle-panel-tab";
    const showTab = (name) => {
      for (const tab of panel.querySelectorAll("[data-tab]")) {
        tab.setAttribute("aria-selected", String(tab.dataset.tab === name));
      }
      for (const section of panel.querySelectorAll("[data-panel]")) {
        section.hidden = section.dataset.panel !== name;
      }
      try {
        localStorage.setItem(TAB, name);
      } catch {}
    };
    let tab = "bottle";
    try {
      tab = localStorage.getItem(TAB) || "bottle";
    } catch {}
    showTab(tab);
    for (const button of panel.querySelectorAll("[data-tab]")) {
      button.addEventListener("click", () => showTab(button.dataset.tab));
    }

    narrow.addEventListener("change", load);
    load();
    loadLogo();
    loadMotion();
  })();
</script>

<style>
  .bottle-panel {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 30;
    width: 16rem;
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 96%);
    box-shadow: 0 6px 24px rgb(0 0 0 / 14%);
    font-size: 0.8125rem;
  }

  .bottle-panel summary {
    cursor: pointer;
    color: var(--ink-muted);
  }

  .bottle-panel label {
    display: grid;
    grid-template-columns: 2rem 1fr 4rem;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.25rem;
  }

  .bottle-panel input {
    width: 100%;
    accent-color: var(--ribbon);
  }

  .bottle-panel output {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .bottle-panel-hint {
    margin: 0.25rem 0 0.5rem;
    color: var(--ink-muted);
  }

  .bottle-panel-heading {
    margin: 0.75rem 0 0;
    color: var(--ink-muted);
  }


  .bottle-panel-wide {
    grid-template-columns: 2rem 1fr;
  }

  .bottle-panel select {
    width: 100%;
    min-height: 2rem;
    font: inherit;
  }

  .bottle-panel-check {
    grid-template-columns: auto 1fr;
  }

  .bottle-panel-check input {
    width: auto;
  }

  .bottle-panel-tabs {
    display: flex;
    gap: 0.25rem;
    margin: 0.5rem 0 0.25rem;
  }

  .bottle-panel .bottle-panel-tabs button {
    flex: 1;
    min-height: 2rem;
    padding: 0;
    border-color: transparent;
    color: var(--ink-muted);
  }

  .bottle-panel .bottle-panel-tabs button[aria-selected="true"] {
    border-color: var(--ink);
    color: var(--ink);
  }

  .bottle-panel-section {
    padding-block: 0.25rem;
  }

  .bottle-panel-choices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 0.5rem;
  }

  .bottle-panel-choices label {
    display: flex;
    gap: 0.4rem;
    min-height: 1.75rem;
  }

  .bottle-panel-choices input {
    width: auto;
  }

  .bottle-panel-actions {
    display: flex;
    gap: 1ch;
  }

  .bottle-panel button {
    min-height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--ink-muted);
    border-radius: 0.25rem;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }

  :global(.home-bottle) {
    cursor: grab;
    touch-action: none;
  }

  /* ---------- Docked header candidates (dev only) ---------- */
  @supports (animation-timeline: scroll()) {
    /* The shell's left edge, for the paper behind the mark. */
    :global(html[data-header] .home-stage) {
      --edge: calc((100vw - var(--shell-width-vw)) / 2);
    }

    /* 1: the mark lies on its side, so the band is only as tall as the
       bottle is wide. */
    /* !important only to win over the panel's own logo sliders, which
       write inline styles on the root. */
    :global(html[data-header="lying"]) {
      --logo-rotate: -90deg !important;
      --logo-top: calc(12px - (var(--logo-height) - var(--logo-width)) / 2) !important;
      --logo-left: calc((var(--logo-height) - var(--logo-width)) / 2) !important;
    }

    :global(html[data-header="lying"] .home-stage::before) {
      height: calc(var(--logo-width) + 24px);
    }

    /* 2: no band; a small patch of paper behind the mark only. */
    :global(html[data-header="chip"] .home-stage::before),
    :global(html[data-header="margin"] .home-stage::before) {
      inset: auto;
      top: calc(var(--logo-top) - 8px);
      left: calc(var(--edge) + var(--logo-left) - 8px);
      width: calc(var(--logo-width) + 16px);
      height: calc(var(--logo-height) + 16px);
    }

    /* 3: the band carries the name, like the article header. */
    :global(html[data-header="signed"] .home-stage::before) {
      height: calc(var(--logo-height) + 2 * var(--logo-top));
      padding-inline-start: calc(var(--edge) + var(--logo-left) + var(--logo-width) + 1.75rem);
      color: var(--ink);
      font-size: var(--type-size);
      letter-spacing: 0.08em;
      line-height: calc(var(--logo-height) + 2 * var(--logo-top));
      content: "李至青";
    }

    /* 4: on wide screens the mark sits in the empty left margin, so nothing
       covers the text; phones have no margin and keep the patch. */
    @media (min-width: 48.0625rem) {
      :global(html[data-header="margin"]) {
        --logo-left: calc(-1 * var(--logo-width) - 1.25rem) !important;
      }

      :global(html[data-header="margin"] .home-stage::before) {
        display: none;
      }
    }

    /* 5: band and mark step aside while reading down, and return the
       moment the reader scrolls back up. */
    :global(html[data-header="reveal"]) {
      container-type: scroll-state;
    }

