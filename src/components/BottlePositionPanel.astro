---
// Dev-only tool for placing the homepage bottle at rest and the logo it docks
// into. Drag the bottle at the top of the page, or use the sliders. Bottle
// values are kept per breakpoint, logo values once, in localStorage
// ("bottle-position") so they survive reloads and can be read back and
// written into global.css. Never rendered in production.
---

<details class="bottle-panel" open>
  <summary>瓶子位置　<span data-mode></span></summary>
  <p class="bottle-panel-heading">動畫（往下捲動比較）</p>
  <div class="bottle-panel-dock">
    <label><input type="radio" name="dock-variant" value="" />原本</label>
    <label><input type="radio" name="dock-variant" value="spin" />A 連轉三圈</label>
    <label><input type="radio" name="dock-variant" value="toss" />B 拋起翻滾</label>
    <label><input type="radio" name="dock-variant" value="ink" />C 紅墨上升</label>
    <label><input type="radio" name="dock-variant" value="bounce" />D Q 彈落地</label>
    <label><input type="radio" name="dock-variant" value="flash" />E 顯影閃光</label>
  </div>
  <p class="bottle-panel-heading">瓶子</p>
  <label>
    <span>上</span>
    <input type="range" data-key="top" min="-20" max="80" step="1" />
    <output data-out="top"></output>
  </label>
  <label>
    <span>左</span>
    <input type="range" data-key="x" min="-20" max="90" step="1" />
    <output data-out="x"></output>
  </label>
  <label>
    <span>高</span>
    <input type="range" data-key="height" min="40" max="240" step="1" />
    <output data-out="height"></output>
  </label>
  <p class="bottle-panel-hint">在頁面最上方直接拖曳瓶子</p>
  <p class="bottle-panel-heading">Logo（捲到底看停靠的樣子）</p>
  <label>
    <span>上</span>
    <input type="range" data-logo="top" min="0" max="80" step="1" />
    <output data-logo-out="top"></output>
  </label>
  <label>
    <span>左</span>
    <input type="range" data-logo="left" min="-20" max="120" step="1" />
    <output data-logo-out="left"></output>
  </label>
  <label>
    <span>角度</span>
    <input type="range" data-logo="rotate" min="-180" max="180" step="1" />
    <output data-logo-out="rotate"></output>
  </label>
  <label>
    <span>寬</span>
    <input type="range" data-logo="width" min="12" max="80" step="1" />
    <output data-logo-out="width"></output>
  </label>
  <div class="bottle-panel-actions">
    <button type="button" data-reset>重設</button>
    <button type="button" data-copy>複製數值</button>
  </div>
</details>

<script is:inline>
  (() => {
    const KEY = "bottle-position";
    const stage = document.querySelector(".home-stage");
    const bottle = document.querySelector(".home-bottle");
    const panel = document.querySelector(".bottle-panel");
    if (!stage || !bottle || !panel) return;

    const narrow = matchMedia("(max-width: 48rem)");
    const mode = () => (narrow.matches ? "narrow" : "wide");
    const label = () => (narrow.matches ? "窄螢幕" : "寬螢幕");
    const props = { top: "--bottle-top", x: "--bottle-x", height: "--bottle-height" };

    const read = () => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || "{}");
      } catch {
        return {};
      }
    };
    const write = (all) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(all));
      } catch {}
    };

    // The stylesheet's values for this breakpoint, read with no overrides.
    const defaults = () => {
      for (const prop of Object.values(props)) stage.style.removeProperty(prop);
      const style = getComputedStyle(stage);
      return {
        top: parseFloat(style.getPropertyValue("--bottle-top")),
        x: Math.round(parseFloat(style.getPropertyValue("--bottle-x")) * 100),
        height: parseFloat(style.getPropertyValue("--bottle-height")),
      };
    };

    let current = {};
    const apply = () => {
      stage.style.setProperty("--bottle-top", `${current.top}dvh`);
      stage.style.setProperty("--bottle-x", `${current.x / 100}`);
      stage.style.setProperty("--bottle-height", `${current.height}dvh`);
      for (const key of Object.keys(props)) {
        panel.querySelector(`[data-key="${key}"]`).value = current[key];
        panel.querySelector(`[data-out="${key}"]`).textContent =
          key === "x" ? `${current[key]}%` : `${current[key]}dvh`;
      }
      panel.querySelector("[data-mode]").textContent = label();
    };
    const save = () => {
      const all = read();
      all[mode()] = { ...current };
      write(all);
    };
    const load = () => {
      current = { ...defaults(), ...(read()[mode()] || {}) };
      apply();
    };

    for (const input of panel.querySelectorAll("input[data-key]")) {
      input.addEventListener("input", () => {
        current[input.dataset.key] = Number(input.value);
        apply();
        save();
      });
    }

    panel.querySelector("[data-reset]").addEventListener("click", () => {
      const all = read();
      delete all[mode()];
      delete all.logo;
      write(all);
      load();
      loadLogo();
    });

    panel.querySelector("[data-copy]").addEventListener("click", async (event) => {
      const all = read();
      const line = (name, value) =>
        value ? `${name}　上 ${value.top}dvh　左 ${value.x}%　高 ${value.height}dvh` : `${name}　未調整`;
      const logoLine = all.logo
        ? `Logo　上 ${all.logo.top}px　左 ${all.logo.left}px　角度 ${all.logo.rotate}deg　寬 ${all.logo.width}px`
        : "Logo　未調整";
      const text = [line("寬螢幕", all.wide), line("窄螢幕", all.narrow), logoLine].join("\n");
      try {
        await navigator.clipboard.writeText(text);
        event.target.textContent = "已複製";
        setTimeout(() => (event.target.textContent = "複製數值"), 1200);
      } catch {}
    });

    // Drag the bottle while the page is at the top, where it rests.
    let drag = null;
    let moved = false;
    bottle.addEventListener("pointerdown", (event) => {
      if (scrollY > 2) return;
      event.preventDefault();
      bottle.setPointerCapture(event.pointerId);
      drag = { x: event.clientX, y: event.clientY, top: current.top, left: current.x };
      moved = false;
    });
    bottle.addEventListener("pointermove", (event) => {
      if (!drag) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
      const shell = stage.getBoundingClientRect().width;
      current.top = Math.round(drag.top + (dy / innerHeight) * 100);
      current.x = Math.round(drag.left + (dx / shell) * 100);
      apply();
    });
    const end = () => {
      if (!drag) return;
      drag = null;
      save();
    };
    bottle.addEventListener("pointerup", end);
    bottle.addEventListener("pointercancel", end);
    // A drag is not a click on the home link.
    bottle.addEventListener(
      "click",
      (event) => {
        if (moved) {
          event.preventDefault();
          moved = false;
        }
      },
      true,
    );
    bottle.addEventListener("dragstart", (event) => event.preventDefault());

    // The logo's docked state: one set of values for every breakpoint.
    const root = document.documentElement;
    const logoProps = { top: "--logo-top", left: "--logo-left", rotate: "--logo-rotate", width: "--logo-width" };
    const logoUnits = { top: "px", left: "px", rotate: "deg", width: "px" };
    const logoDefaults = () => {
      for (const prop of Object.values(logoProps)) root.style.removeProperty(prop);
      const probe = document.createElement("div");
      probe.style.cssText =
        "position:absolute;visibility:hidden;top:var(--logo-top);left:var(--logo-left);width:var(--logo-width);rotate:var(--logo-rotate)";
      document.body.append(probe);
      const style = getComputedStyle(probe);
      const values = {
        top: Math.round(parseFloat(style.top)),
        left: Math.round(parseFloat(style.left)),
        rotate: Math.round(parseFloat(style.rotate)),
        width: Math.round(parseFloat(style.width)),
      };
      probe.remove();
      return values;
    };
    let logo = {};
    const applyLogo = () => {
      for (const key of Object.keys(logoProps)) {
        root.style.setProperty(logoProps[key], `${logo[key]}${logoUnits[key]}`);
        panel.querySelector(`[data-logo="${key}"]`).value = logo[key];
        panel.querySelector(`[data-logo-out="${key}"]`).textContent = `${logo[key]}${logoUnits[key]}`;
      }
    };
    const loadLogo = () => {
      logo = { ...logoDefaults(), ...(read().logo || {}) };
      applyLogo();
    };
    for (const input of panel.querySelectorAll("input[data-logo]")) {
      input.addEventListener("input", () => {
        logo[input.dataset.logo] = Number(input.value);
        applyLogo();
        const all = read();
        all.logo = { ...logo };
        write(all);
      });
    }

    // Which dock animation to preview.
    const DOCK = "dock-variant";
    const setDock = (value) => {
      if (value) root.dataset.dock = value;
      else delete root.dataset.dock;
      for (const radio of panel.querySelectorAll('input[name="dock-variant"]')) {
        radio.checked = radio.value === value;
      }
    };
    let dock = "";
    try {
      dock = localStorage.getItem(DOCK) || "";
    } catch {}
    setDock(dock);
    for (const radio of panel.querySelectorAll('input[name="dock-variant"]')) {
      radio.addEventListener("change", () => {
        setDock(radio.value);
        try {
          localStorage.setItem(DOCK, radio.value);
        } catch {}
      });
    }

    narrow.addEventListener("change", load);
    load();
    loadLogo();
  })();
</script>

<style>
  .bottle-panel {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 30;
    width: 16rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 96%);
    box-shadow: 0 6px 24px rgb(0 0 0 / 14%);
    font-size: 0.8125rem;
  }

  .bottle-panel summary {
    cursor: pointer;
    color: var(--ink-muted);
  }

  .bottle-panel label {
    display: grid;
    grid-template-columns: 2rem 1fr 4rem;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.25rem;
  }

  .bottle-panel input {
    width: 100%;
    accent-color: var(--ribbon);
  }

  .bottle-panel output {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .bottle-panel-hint {
    margin: 0.25rem 0 0.5rem;
    color: var(--ink-muted);
  }

  .bottle-panel-heading {
    margin: 0.75rem 0 0;
    color: var(--ink-muted);
  }

  .bottle-panel-dock {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 0.5rem;
    margin-bottom: 0.25rem;
  }

  .bottle-panel-dock label {
    display: flex;
    gap: 0.4rem;
    min-height: 1.75rem;
  }

  .bottle-panel-dock input {
    width: auto;
  }

  .bottle-panel-actions {
    display: flex;
    gap: 1ch;
  }

  .bottle-panel button {
    min-height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--ink-muted);
    border-radius: 0.25rem;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }

  :global(.home-bottle) {
    cursor: grab;
    touch-action: none;
  }

  /* ---------- Dock animation candidates (dev only) ----------
     Each keeps the bottle's bottom edge at or above the plain linear path,
     so the diary still never slides under it. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(html[data-dock] .home-bottle) {
        --start-left: calc(
          var(--shell-left) + var(--shell-width) * var(--bottle-x) - var(--bottle-width) *
            var(--bottle-align)
        );
        --end-left: calc(var(--shell-left) + var(--logo-left));
      }

      /* A: three turntable revolutions on an arc that overshoots the corner. */
      :global(html[data-dock="spin"] .home-bottle) {
        animation-name: dock-fall, dock-sweep;
        animation-timing-function: cubic-bezier(0.2, 0.6, 0.35, 1), cubic-bezier(0.25, 1.45, 0.45, 1);
        animation-fill-mode: both, both;
        animation-timeline: scroll(root), scroll(root);
        animation-range: 0 var(--dock-range), 0 var(--dock-range);
      }

      :global(html[data-dock="spin"] .home-bottle .bottle-photo),
      :global(html[data-dock="spin"] .home-bottle .bottle-silhouette) {
        animation-iteration-count: 3, 1;
      }

      :global(html[data-dock="spin"] .home-bottle .bottle-still) {
        animation-range: 0 calc(var(--dock-range) / 63);
      }

      /* B: tossed up, tumbled a full turn, dropped into the corner. */
      :global(html[data-dock="toss"] .home-bottle) {
        animation-name: dock-toss;
      }

      /* C: the silhouette rises from the foot in ribbon red, then sets to ink. */
      :global(html[data-dock="ink"] .home-bottle .bottle-silhouette) {
        animation-name: bottle-mask-turn, ink-rise;
      }

      /* D: stretches in flight, squashes and settles on landing. */
      :global(html[data-dock="bounce"] .home-bottle) {
        transform-origin: 50% 100%;
        animation-name: dock-quick, squash;
        animation-timing-function: linear, linear;
        animation-fill-mode: both, both;
        animation-timeline: scroll(root), scroll(root);
        animation-range: 0 var(--dock-range), 0 var(--dock-range);
      }

      /* E: a zoom punch in saturated colour, burned to black through a red flash. */
      /* The punch is early and modest: on a phone there is little room
         between the greeting above and the diary below. */
      :global(html[data-dock="flash"] .home-bottle) {
        animation-name: bottle-dock, punch;
        animation-timing-function: linear, linear;
        animation-fill-mode: both, both;
        animation-timeline: scroll(root), scroll(root);
        animation-range: 0 var(--dock-range), 0 var(--dock-range);
      }

      :global(html[data-dock="flash"] .home-bottle .bottle-photo) {
        animation-name: bottle-photo-turn, bottle-lift, darkroom;
        animation-timing-function: steps(var(--frames), jump-none), linear, linear;
        animation-fill-mode: both, both, both;
        animation-timeline: scroll(root), scroll(root), scroll(root);
        animation-range: 0 var(--dock-range), 0 var(--dock-range), 0 var(--dock-range);
      }

      :global(html[data-dock="flash"] .home-bottle .bottle-silhouette) {
        animation-name: bottle-mask-turn, bottle-strike, flash-colour;
        animation-timing-function: steps(var(--frames), jump-none), linear, linear;
        animation-fill-mode: both, both, both;
        animation-timeline: scroll(root), scroll(root), scroll(root);
        animation-range: 0 var(--dock-range), 0 var(--dock-range), 0 var(--dock-range);
      }
    }
  }

  /* The spin rides the shrink, so the bottle is small by the time it is
     sideways and never sweeps across the greeting. */
  @keyframes dock-fall {
    to {
      top: var(--logo-top);
      height: var(--logo-height);
      rotate: calc(var(--logo-rotate) - 360deg);
    }
  }

  @keyframes dock-sweep {
    to {
      left: var(--end-left);
    }
  }

  @keyframes dock-toss {
    /* A gentle start: rising faster would lift it into the greeting. */
    0% {
      animation-timing-function: cubic-bezier(0.3, 0.4, 0.45, 1);
    }

    40% {
      top: calc(var(--logo-top) - 6dvh);
      left: calc(var(--start-left) * 0.4 + var(--end-left) * 0.6 + 12vw);
      height: calc(var(--bottle-height) * 0.32);
      rotate: -200deg;
      animation-timing-function: cubic-bezier(0.55, 0, 0.85, 0.4);
    }

    100% {
      top: var(--logo-top);
      left: var(--end-left);
      height: var(--logo-height);
      rotate: calc(var(--logo-rotate) - 360deg);
    }
  }

  @keyframes ink-rise {
    0% {
      opacity: 1;
      clip-path: inset(100% 0 0 0);
      background-color: var(--ribbon);
    }

    50% {
      opacity: 1;
      clip-path: inset(0 0 0 0);
      background-color: var(--ribbon);
    }

    80%,
    100% {
      opacity: 1;
      clip-path: inset(0 0 0 0);
      background-color: var(--ink);
    }
  }

  @keyframes dock-quick {
    0% {
      animation-timing-function: cubic-bezier(0.3, 0, 0.2, 1);
    }

    80%,
    100% {
      top: var(--logo-top);
      left: var(--end-left);
      height: var(--logo-height);
      rotate: var(--logo-rotate);
    }
  }

  @keyframes squash {
    0% {
      scale: 1 1;
    }

    40% {
      scale: 0.8 1.2;
    }

    78% {
      scale: 0.88 1.14;
    }

    84% {
      scale: 1.45 0.6;
    }

    90% {
      scale: 0.85 1.16;
    }

    95% {
      scale: 1.08 0.94;
    }

    100% {
      scale: 1 1;
    }
  }

  @keyframes punch {
    0% {
      scale: 1;
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    10% {
      scale: 1.12;
      animation-timing-function: cubic-bezier(0.7, 0, 0.3, 1);
    }

    30%,
    100% {
      scale: 1;
    }
  }

  @keyframes darkroom {
    0% {
      filter: none;
    }

    10% {
      filter: saturate(2.4) contrast(1.35);
    }

    38% {
      filter: saturate(0) contrast(3) brightness(0.7);
    }

    55%,
    100% {
      filter: brightness(0);
    }
  }

  @keyframes flash-colour {
    0%,
    48% {
      background-color: var(--ribbon);
    }

    72%,
    100% {
      background-color: var(--ink);
    }
  }
</style>
