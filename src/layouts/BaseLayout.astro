---
import { SITE } from "../config/site.js";
import {
  getAtomFeedUrl,
  UI,
  type SiteLanguage,
} from "../config/i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  language: SiteLanguage;
  alternates?: ReadonlyArray<{
    language: SiteLanguage;
    path: string;
  }>;
  languageSwitchPath?: string;
  showHeader?: boolean;
}

const {
  title,
  language,
  alternates = [],
  languageSwitchPath = UI[language].languageSwitch.href,
  showHeader = true,
} = Astro.props;
const pageTitle = title ? `${title}　${SITE.title}` : SITE.title;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url);
const atomFeedUrl = getAtomFeedUrl(language);
const ui = UI[language];
const showSecondarySiteTitle = SITE.title !== SITE.author.displayName;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={SITE.description[language]} />
    <meta name="author" content={SITE.author.name} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={SITE.title}
      href={atomFeedUrl}
    />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.language}
        href={new URL(alternate.path, SITE.url)}
      />
    ))}
    <title>{pageTitle}</title>
  </head>
  <body data-surface="story-journal">
    <!--
    THESIS: Story Journal turns a personal archive into one calm, tactile narrative and refuses both oversized-name minimalism and segmented app navigation.
    OWN-WORLD: Cool index-card stock, near-black ink, restrained accession marks, and uninterrupted editorial whitespace.
    STORY: Readers meet the author and the purpose of the writing, can respond directly, then continue naturally into the chronology and an unhurried reading column.
    FIRST VIEWPORT: A compact signature and quiet language utility lead directly into the author introduction; the chronological register follows as the next passage in the same journal.
    FORM: Approved Compact Register, first of three composition probes; direction seed f0bd5f13.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main-content">{ui.skipContentLabel}</a>
    <div class="site-shell">
      {showHeader && (
      <header class="site-header">
        <div class="site-identity">
          <a class="author-signature" href={ui.homePath}>
            {SITE.author.displayName}
          </a>
          {showSecondarySiteTitle && (
            <>
              <span class="identity-rule" aria-hidden="true"></span>
              <span class="site-title">{SITE.title}</span>
            </>
          )}
        </div>
        <nav class="site-nav" aria-label={ui.navigationLabel}>
          <a class="language-link" href={languageSwitchPath}>
            {ui.languageSwitch.label}
          </a>
        </nav>
      </header>
      )}
      <main id="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>
