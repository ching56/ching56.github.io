---
import { SITE } from "../config/site.js";
import {
  getAtomFeedUrl,
  UI,
  type SiteLanguage,
} from "../config/i18n";
import BottleMark from "../components/BottleMark.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  language: SiteLanguage;
  alternates?: ReadonlyArray<{
    language: SiteLanguage;
    path: string;
  }>;
  languageSwitchPath?: string;
  showHeader?: boolean;
}

const {
  title,
  language,
  alternates = [],
  languageSwitchPath = UI[language].languageSwitch.href,
  showHeader = true,
} = Astro.props;
const pageTitle = title ? `${title}　${SITE.title}` : SITE.title;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url);
const atomFeedUrl = getAtomFeedUrl(language);
const ui = UI[language];
const showSecondarySiteTitle = SITE.title !== SITE.author.displayName;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={SITE.description[language]} />
    <meta name="author" content={SITE.author.name} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={SITE.title}
      href={atomFeedUrl}
    />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.language}
        href={new URL(alternate.path, SITE.url)}
      />
    ))}
    <title>{pageTitle}</title>
  </head>
  <body data-surface="character-proof">
    <!--
    THESIS: Character Proof types the pottery diary out on white paper: every picture is first struck as typewriter glyphs and develops into the photograph, refusing the soft-paper journal and the photo-grid portfolio.
    OWN-WORLD: Pure white stock, black and red ribbon ink, one monospace cell grid, character-art pictures, square typed brackets for controls; the dates alone are handwritten.
    STORY: Readers watch the glyph bottle turn and settle into the home mark, meet the potter, then follow numbered making steps whose photos resolve out of type as they scroll.
    FIRST VIEWPORT: A 40dvh glyph bottle at the column's left edge with the greeting and typed mail bracket beneath; the numbered diary follows.
    FORM: Typewriter character art on white, a challenger fused with the pinned grid-and-numbered-steps concept; direction seed 9062ef67.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main-content">{ui.skipContentLabel}</a>
    <div class="site-shell">
      {showHeader && (
      <header class="site-header">
        <div class="site-identity">
          <a class="site-mark" href={ui.homePath}>
            <BottleMark variant="logo" />
            <span class="author-signature">{SITE.author.displayName}</span>
          </a>
          {showSecondarySiteTitle && (
            <>
              <span class="identity-rule" aria-hidden="true"></span>
              <span class="site-title">{SITE.title}</span>
            </>
          )}
        </div>
        <nav class="site-nav" aria-label={ui.navigationLabel}>
          <a class="language-link" href={languageSwitchPath}>
            {ui.languageSwitch.label}
          </a>
        </nav>
      </header>
      )}
      <main id="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>
