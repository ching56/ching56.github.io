---
import { SITE } from "../config/site.js";
import {
  getAtomFeedUrl,
  UI,
  type SiteLanguage,
} from "../config/i18n";
import BottleMark from "../components/BottleMark.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  language: SiteLanguage;
  alternates?: ReadonlyArray<{
    language: SiteLanguage;
    path: string;
  }>;
  showHeader?: boolean;
  /** Article pages: the mark goes back to home's place when home sent you. */
  markReturns?: boolean;
}

const {
  title,
  language,
  alternates = [],
  showHeader = true,
  markReturns = false,
} = Astro.props;
const pageTitle = title ? `${title}　${SITE.title}` : SITE.title;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url);
const atomFeedUrl = getAtomFeedUrl(language);
const ui = UI[language];
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={SITE.description[language]} />
    <meta name="author" content={SITE.author.name} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={SITE.title}
      href={atomFeedUrl}
    />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.language}
        href={new URL(alternate.path, SITE.url)}
      />
    ))}
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body data-surface="character-proof">
    <!--
    THESIS: Character Proof types the pottery diary out on white paper beside plain photographs of the work, refusing the soft-paper journal and the photo-grid portfolio.
    OWN-WORLD: Pure white stock, black and red ribbon ink, one monospace cell grid, plain photographs, square typed brackets for controls; the dates alone are handwritten.
    STORY: Readers meet the potter beside the bottle, watch it turn as they scroll, then follow the diary entries and their photos.
    FIRST VIEWPORT: The bottle photo on the left with the greeting and typed mail bracket beside it; the bottle turns on its turntable as the reader scrolls on into the diary.
    FORM: Typewriter type on white (the character art was later removed by the user), a challenger fused with the pinned grid-and-numbered-steps concept; direction seed 9062ef67.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main-content">{ui.skipContentLabel}</a>
    <div class="site-shell">
      {showHeader && (
      <header class="site-header">
        <nav class="site-identity" aria-label={ui.breadcrumbLabel}>
          <ol class="site-crumbs">
            <li>
              <a class="site-mark" href={ui.homePath} aria-label={ui.homeLabel}>
                <BottleMark variant="logo" />
              </a>
            </li>
          </ol>
        </nav>
        {markReturns && (
          <script is:inline>
            // Came here from home? Then the mark goes back rather than
            // reloading home, so home keeps your place (the bottle still
            // morphs across). Any other way in, it stays a plain link.
            (() => {
              const mark = document.querySelector(".site-mark");
              if (!mark) return;
              mark.addEventListener("click", (event) => {
                if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
                let from;
                try {
                  from = new URL(document.referrer);
                } catch {
                  return;
                }
                if (from.origin !== location.origin || from.pathname !== mark.pathname || history.length < 2) return;
                event.preventDefault();
                history.back();
              });
            })();
          </script>
        )}
      </header>
      )}
      <main id="main-content">
        <slot />
      </main>
    </div>
    <a class="to-top" href="#top" aria-label={ui.backToTopLabel}>↑</a>
  </body>
</html>
