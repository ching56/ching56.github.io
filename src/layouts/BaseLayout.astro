---
import { SITE } from "../config/site.js";
import {
  getAtomFeedUrl,
  UI,
  type SiteLanguage,
} from "../config/i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  language: SiteLanguage;
  alternates?: ReadonlyArray<{
    language: SiteLanguage;
    path: string;
  }>;
  languageSwitchPath?: string;
}

const {
  title,
  language,
  alternates = [],
  languageSwitchPath = UI[language].languageSwitch.href,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url);
const atomFeedUrl = getAtomFeedUrl(language);
const ui = UI[language];
const showSecondarySiteTitle = SITE.title !== SITE.author.displayName;
const isPostsIndex = Astro.url.pathname === ui.homePath;
const isBlogPostPage = Astro.url.pathname.startsWith(`${ui.homePath}blog/`);
const isPostsPage = isPostsIndex || isBlogPostPage;
const postsAriaCurrent = isPostsIndex
  ? "page"
  : isBlogPostPage
    ? "location"
    : undefined;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={SITE.description[language]} />
    <meta name="author" content={SITE.author.name} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={SITE.title}
      href={atomFeedUrl}
    />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.language}
        href={new URL(alternate.path, SITE.url)}
      />
    ))}
    <title>{pageTitle}</title>
  </head>
  <body data-surface="accession-tabs">
    <!--
    THESIS: Accession Tabs turns a personal archive into a calm, tactile register and refuses the oversized-name minimalist blog.
    OWN-WORLD: Cool index-card stock, near-black rules, restrained accession marks, and translucent cobalt/citron notebook-glass tabs.
    STORY: Readers meet the author and the purpose of the writing, can respond directly, then scan real posts chronologically and settle into an unhurried reading column.
    FIRST VIEWPORT: A compact signature and familiar top tabs lead into an open author introduction separated by composition and whitespace; the chronological register follows as the next distinct passage.
    FORM: Approved Compact Register, first of three composition probes; direction seed f0bd5f13.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main-content">{ui.skipContentLabel}</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-identity">
          <a class="author-signature" href={ui.homePath}>
            {SITE.author.displayName}
          </a>
          {showSecondarySiteTitle && (
            <>
              <span class="identity-rule" aria-hidden="true"></span>
              <span class="site-title">{SITE.title}</span>
            </>
          )}
        </div>
        <nav class="site-nav" aria-label={ui.navigationLabel}>
          <a
            class:list={["nav-tab", "nav-tab--cobalt", { "is-active": isPostsPage }]}
            href={ui.homePath}
            aria-current={postsAriaCurrent}
          >
            {ui.postsLabel}
          </a>
          {ui.aboutLabel && (
            <a
              class="nav-tab nav-tab--citron"
              href="/zh-TW/#about"
            >
              {ui.aboutLabel}
            </a>
          )}
          <a class="nav-tab nav-tab--clear" href={languageSwitchPath}>
            {ui.languageSwitch.label}
          </a>
        </nav>
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer class="site-footer">
        <a href={`mailto:${SITE.author.email}`}>{SITE.author.email}</a>
      </footer>
    </div>
  </body>
</html>
