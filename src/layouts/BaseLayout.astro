---
import { SITE } from "../config/site.js";
import {
  getAtomFeedUrl,
  UI,
  type SiteLanguage,
} from "../config/i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  language: SiteLanguage;
  alternates?: ReadonlyArray<{
    language: SiteLanguage;
    path: string;
  }>;
  languageSwitchPath?: string;
  scene?: "home" | "article";
}

const {
  title,
  language,
  alternates = [],
  languageSwitchPath = UI[language].languageSwitch.href,
  scene = "home",
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url);
const atomFeedUrl = getAtomFeedUrl(language);
const ui = UI[language];
const showSecondarySiteTitle = SITE.title !== SITE.author.displayName;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={SITE.description[language]} />
    <meta name="author" content={SITE.author.name} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={SITE.title}
      href={atomFeedUrl}
    />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.language}
        href={new URL(alternate.path, SITE.url)}
      />
    ))}
    <meta name="theme-color" content="#11181c" />
    <title>{pageTitle}</title>
    <script is:inline src="/night.js" defer></script>
  </head>
  <body data-surface="programmed-dream" data-scene={scene}>
    <!--
    THESIS: Programmed Dream sets a personal journal over an evening photograph that is painted live in code; it refuses the white-paper blog and the photo-hero-plus-cards template.
    OWN-WORLD: Evening magic hour in the user's seven colours (#11181C ink, blue, cyan, lavender, rose, vermilion, amber): a heavily defocused, highly saturated 5:30 pm exposure: a low sun throwing flat horizontal light, sun-facing faces amber and vermilion, the side turned away (and the text side) purple, never black or grey; crisp warm ivory serif with quiet sans; no cards, borders, fills, or ornaments.
    STORY: Readers meet the author in one line, glimpse the dachshund, the radio, and the wheel the life is made of, then choose a piece to read in an unhurried ivory column.
    FIRST VIEWPORT: Small serif masthead left, sans locale link right; the serif greeting and the title list hold the dark left column while the subject glows in the right half (lower third on phones).
    FORM: A dark left column of ivory type over a fixed scene in the right half (low and right, under-exposed, on phones); seed: 8b1de78f, overridden by the user-pinned brief.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <canvas class="night" data-night aria-hidden="true"></canvas>
    <a class="skip-link" href="#main-content">{ui.skipContentLabel}</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-identity">
          <a class="author-signature" href={ui.homePath}>
            {SITE.author.displayName}
          </a>
          {showSecondarySiteTitle && (
            <>
              <span class="identity-rule" aria-hidden="true"></span>
              <span class="site-title">{SITE.title}</span>
            </>
          )}
        </div>
        {scene === "home" && (
          <button
            class="motion-toggle"
            type="button"
            data-motion-toggle
            data-pause-label={ui.motionPauseLabel}
            data-play-label={ui.motionPlayLabel}
            hidden
          >
            {ui.motionPauseLabel}
          </button>
        )}
        <nav class="site-nav" aria-label={ui.navigationLabel}>
          <a class="language-link" href={languageSwitchPath}>
            {ui.languageSwitch.label}
          </a>
        </nav>
      </header>
      <main id="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>
