---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getPostDate,
  getPostSlug,
  getPostsByLanguage,
} from "../../lib/posts";

const posts = (await getPostsByLanguage("zh-TW"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout language="zh-TW">
  <h1>文章</h1>
  <ol class="post-list">
    {posts.map((post) => {
      const date = getPostDate(post.data.date, "zh-TW");

      return (
        <li>
          <a href={`/zh-TW/blog/${getPostSlug(post)}/`}>{post.data.title}</a>
          <time datetime={date.dateTime}>{date.label}</time>
        </li>
      );
    })}
  </ol>
</BaseLayout>
