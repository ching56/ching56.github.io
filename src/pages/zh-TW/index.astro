---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AboutSection from "../../components/AboutSection.astro";
import NowSection from "../../components/NowSection.astro";
import PostList from "../../components/PostList.astro";
import { EDITION_HOME_ALTERNATES, UI } from "../../config/i18n";
import { getPageByLanguage, hasContent } from "../../lib/posts";

const about = await getPageByLanguage("zh-TW", "about");
const now = await getPageByLanguage("zh-TW", "now");

if (!about) {
  throw new Error("Missing the zh-TW about content entry");
}
---

<BaseLayout language="zh-TW" alternates={EDITION_HOME_ALTERNATES} showHeader={false}>
  <div class="home-stage">
    <div class="home-flow">
      <div class="home-hero">
        <div class="home-bottle-slot">
          <a class="home-bottle" href={UI["zh-TW"].homePath} aria-label="首頁"></a>
        </div>
        <AboutSection page={about} />
      </div>
      {now && hasContent(now) && <NowSection page={now} />}
      <PostList language="zh-TW" />
    </div>
    <div class="creative-coding-area" data-creative-coding-area aria-hidden="true"></div>
  </div>
</BaseLayout>
