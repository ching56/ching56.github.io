---
import { render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getPostDate,
  getPostSlug,
  getPostsByLanguage,
} from "../../lib/posts";

const about = (await getPostsByLanguage("zh-TW")).find(
  (post) => getPostSlug(post) === "about",
);

if (!about) {
  throw new Error("Missing the zh-TW about content entry");
}

const { Content } = await render(about);
const date = getPostDate(about.data.date, "zh-TW");
---

<BaseLayout title={about.data.title} language="zh-TW">
  <article>
    <header class="post-header">
      <h1>{about.data.title}</h1>
      <time datetime={date.dateTime}>{date.label}</time>
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>
