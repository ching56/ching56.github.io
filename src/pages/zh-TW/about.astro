---
import PostArticle from "../../components/PostArticle.astro";
import {
  getPostSlug,
  getPostsByLanguage,
} from "../../lib/posts";

const about = (await getPostsByLanguage("zh-TW")).find(
  (post) => getPostSlug(post) === "about",
);

if (!about) {
  throw new Error("Missing the zh-TW about content entry");
}
---

<PostArticle post={about} />
